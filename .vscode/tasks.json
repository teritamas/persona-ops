{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "開発用サーバーを起動します (ホットリロード有効)"
    },
    {
      "label": "api: build",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "detail": "TypeScriptコードをビルド（コンパイル）します"
    },
    {
      "label": "api: start",
      "type": "shell",
      "command": "pnpm start",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "detail": "ビルドされたプロダクション用サーバーを起動します"
    },
    {
      "label": "api: test",
      "type": "shell",
      "command": "pnpm test",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "detail": "vitestを使用してテストを実行し、カバレッジを測定します"
    },
    {
      "label": "api: typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "detail": "TypeScriptの型チェックを実行します (ファイル出力なし)"
    },
    {
      "label": "api: lint:fix",
      "type": "shell",
      "command": "pnpm lint:fix",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "detail": "ESLintを使用してソースコードの静的解析をして修正します"
    },
    {
      "label": "api: format",
      "type": "shell",
      "command": "pnpm format",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "detail": "Prettierを使用してプロジェクト全体のコードを自動整形します"
    },
    {
      "label": "api: format:check",
      "type": "shell",
      "command": "pnpm format:check",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "detail": "Prettierを使用してコードが整形ルールに準拠しているか確認します"
    },
    {
      "label": "api: verify:gcp",
      "type": "shell",
      "command": "pnpm verify:gcp",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "detail": "Google Cloud環境（FirestoreやGCS等）への接続および認証設定を検証します"
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "CSSのwatchと開発サーバーを起動します"
    },
    {
      "label": "frontend: start",
      "type": "shell",
      "command": "pnpm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "detail": "Expressサーバーを起動します"
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "detail": "配信用のCSSを一度だけ生成します。frontendでは build と build:css は同義です"
    },
    {
      "label": "frontend: build:css",
      "type": "shell",
      "command": "pnpm build:css",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "detail": "Tailwind CSSを一度だけ生成して終了します。Hot Reloadはしません"
    },
    {
      "label": "frontend: watch:css",
      "type": "shell",
      "command": "pnpm watch:css",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Tailwind CSSの入力変更を監視し、変更のたびに再生成し続けます"
    },
    {
      "label": "frontend: lint:fix",
      "type": "shell",
      "command": "pnpm lint:fix",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "detail": "ESLintでJavaScriptを静的解析して修正します。"
    },
    {
      "label": "frontend: test",
      "type": "shell",
      "command": "pnpm test",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "detail": "Node.js標準テストランナーで単体テストを実行します。lintは静的解析、testは実行時の振る舞いを確認します"
    },
    {
      "label": "dev: all",
      "dependsOn": [
        "api: dev",
        "frontend: dev"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "detail": "APIとフロントエンドの両方の開発サーバーを起動します"
    },
    {
      "label": "format: all",
      "type": "shell",
      "command": "pnpm format",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": [],
      "detail": "APIのPrettierを実行します"
    },
    {
      "label": "test: all",
      "dependsOn": [
        "api: test",
        "frontend: test"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "detail": "APIとフロントエンドの両方のテストを実行します"
    },
    {
      "label": "lint:fix: all",
      "dependsOn": [
        "api: lint:fix",
        "frontend: lint:fix"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "detail": "ESLintで両方のコードを修正します。"
    },
    {
      "label": "full-ci-cycle: all",
      "dependsOn": [
        "format: all",
        "test: all",
        "lint:fix: all"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "リントの修正、フォーマット適応、テスト実行、両サーバー起動を順番に行います"
    }
  ]
}
