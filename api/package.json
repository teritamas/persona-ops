{
  "name": "@persona-ops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --env-file-if-exists=.env.local --import tsx src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:gcp": "node --env-file=.env.local --import tsx scripts/verify-gcp.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "8.6.0",
    "@google-cloud/storage": "7.21.0",
    "@google/adk": "1.3.0",
    "fastify": "5.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "prettier": "3.9.4",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  }
}
