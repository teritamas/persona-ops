    <!-- トップナビゲーションバー -->
    <header class="h-14 bg-white border-b border-slate-200 flex items-center pr-6 pl-[18px] z-50 shrink-0">
      <div class="flex items-center w-full">
        <!-- ロゴ -->
        <div class="font-['Quicksand'] text-2xl font-bold tracking-tight flex items-center mr-8 gap-1.5">
          <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <div><span class="text-slate-700">Persona</span><span class="text-orange-500">Ops</span></div>
        </div>

        <div class="relative flex-1" id="project-menu-container">
          <button 
            onclick="toggleProjectMenu()"
            class="flex items-center gap-1.5 hover:bg-slate-50 px-3 py-1.5 rounded-lg transition-colors group"
          >
            <span class="font-bold text-sm text-slate-700"><%= activeProject.name %></span>
            <svg class="w-[0.875rem] h-[0.875rem] text-slate-400 group-hover:text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          <div id="project-dropdown" class="hidden absolute top-full left-0 mt-2 w-64 bg-white rounded-xl shadow-xl border border-slate-100 z-50 py-2 animate-fade-in">
            <div class="px-4 py-2 text-xs font-bold text-slate-400 uppercase tracking-wider">Projects</div>
            <% mockProjects.forEach(function(p) { %>
              <button 
                onclick="switchProject('<%= p.id %>')"
                class="w-full text-left px-4 py-2 text-sm flex items-center justify-between hover:bg-slate-50 transition-colors <%= p.id === activeProjectId ? 'text-orange-600 font-bold bg-orange-50/50' : 'text-slate-700' %>"
              >
                <span class="truncate"><%= p.name %></span>
                <% if(p.id === activeProjectId) { %>
                  <svg class="w-[0.875rem] h-[0.875rem] text-orange-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <% } %>
              </button>
            <% }); %>
            <div class="border-t border-slate-100 mt-2 pt-2">
              <button 
                onclick="createProject()"
                class="w-full text-left px-4 py-2 text-sm text-slate-600 hover:text-orange-600 hover:bg-slate-50 flex items-center transition-colors font-medium"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg> 新規プロジェクト作成
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>
