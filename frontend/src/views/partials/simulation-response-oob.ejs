<%- include('sandbox-characters', { activeProject, simulationDone, selectedPersonaId }) %>

<div id="chat-messages-container" hx-swap-oob="beforeend">
  <%- include('chat-message', { msg: userMsg, activeProject }) %>
  <%- include('chat-message', { msg: agentMsg, activeProject }) %>
</div>

<textarea 
  id="inputText"
  name="inputText"
  rows="1"
  placeholder="新機能の仕様や質問を入力..."
  class="w-full bg-transparent text-slate-800 text-sm py-2 px-3 resize-none overflow-hidden block min-h-[40px] max-h-[200px] focus:outline-none"
  required
  hx-swap-oob="true"
  oninput="this.style.height = 'auto'; this.style.height = (this.scrollHeight) + 'px';"
  onkeydown="if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); this.form.requestSubmit(); }"
></textarea>

<div id="reception-rate-badge" hx-swap-oob="true" class="flex items-center gap-3 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm animate-fade-in">
  <span class="text-xs font-bold text-slate-500">全体受容度:</span>
  <span class="text-sm font-extrabold text-slate-800">72%</span>
  <span class="text-[10px] font-bold text-green-600 bg-green-100 px-1.5 py-0.5 rounded">Good</span>
</div>

<% if (selectedPersonaId) { %>
  <%- include('persona-detail-oob', { p: activeProject.personas.find(p => p.id === selectedPersonaId), activeProject, simulationDone, selectedPersonaId }) %>
<% } %>
