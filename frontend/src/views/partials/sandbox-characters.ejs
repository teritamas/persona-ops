<%
  const selectedId = selectedSimulation?.id;
  const isPolling = selectedSimulation && (selectedSimulation.status === 'running' || selectedSimulation.status === 'queued');
  const pollingAttrs = isPolling
    ? `hx-get="/${activeProject.id}/view/simulation-square?simulationId=${encodeURIComponent(selectedId)}"` +
      ` hx-trigger="every 3s"` +
      ` hx-swap="outerHTML"`
    : '';
%>
<div id="sandbox-characters"
     class="relative w-full h-full max-w-5xl max-h-[800px] z-10"
     <%- pollingAttrs %>
     <%= (typeof isOob !== 'undefined' && isOob) ? 'hx-swap-oob="outerHTML"' : '' %>
>

  <% activeProject.personas.forEach((p, idx) => { %>
    <%
      const isSelected = selectedPersonaId === p.id;
      
      // selectedSimulation からこのペルソナに対する reaction を探す
      let reaction = null;
      if (typeof selectedSimulation !== 'undefined' && selectedSimulation && selectedSimulation.reactions) {
        reaction = selectedSimulation.reactions.find(r => r.personaId === p.id);
      }

      let reactionHtml = '';
      if (reaction && reaction.status === 'completed') {
        let iconColor = 'text-slate-500 bg-slate-100 border-slate-200';
        let iconSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>';
        let bgGradient = 'from-slate-50 to-white';
        if (reaction.sentiment === 'positive') {
          iconColor = 'text-green-600 bg-green-100 border-green-200';
          iconSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
          bgGradient = 'from-emerald-50 to-white';
        } else if (reaction.sentiment === 'negative') {
          iconColor = 'text-red-600 bg-red-100 border-red-200';
          iconSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
          bgGradient = 'from-rose-50 to-white';
        } else if (reaction.sentiment === 'neutral') {
          iconColor = 'text-slate-600 bg-slate-100 border-slate-200';
          iconSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
        }

        reactionHtml = `
          <div class="absolute bottom-[95px] left-1/2 -translate-x-1/2 w-64 bg-gradient-to-b ${bgGradient} p-4 rounded-[1.5rem] shadow-[0_10px_40px_rgba(0,0,0,0.08)] border-2 border-white animate-pop-in z-20 flex flex-col hover:-translate-y-1 transition-transform duration-300" style="animation-delay: ${idx * 0.2}s">
            <div class="absolute -bottom-2.5 left-1/2 -translate-x-1/2 w-5 h-5 bg-white border-b-2 border-r-2 border-white transform rotate-45 shadow-[4px_4px_10px_rgba(0,0,0,0.02)]"></div>
            <div class="flex items-center gap-2 mb-2.5 pb-2.5 border-b border-slate-100/60">
              <div class="shrink-0 p-1.5 rounded-xl border shadow-sm ${iconColor}">
                ${iconSvg}
              </div>
              <span class="text-xs font-black text-slate-700 truncate tracking-tight">${p.name}</span>
            </div>
            <p class="text-xs text-slate-700 leading-relaxed font-bold">${reaction.shortFeedback === 'undefined' ? '' : reaction.shortFeedback}</p>
          </div>
        `;
      }
    %>
    <div
      class="draggable-node absolute cursor-grab active:cursor-grabbing group flex flex-col items-center transition-[transform] duration-300 <%= isSelected ? 'z-50 scale-110' : 'z-10' %>"
      style="left: <%= p.x %>%; top: <%= p.y %>%; transform: translate(-50%, -50%)"
      data-node-id="persona-<%= p.id %>"
      data-project-id="<%= activeProject.id %>"
      data-simulation-id="<%= selectedId || '' %>"
    >
      <%- reactionHtml %>
      <div class="relative animate-float flex flex-col items-center transition-all duration-300 group-hover:-translate-y-2" style="animation-delay: <%= idx * 0.5 %>s">
        <div class="absolute -bottom-4 w-12 h-2.5 bg-black/10 rounded-[100%] blur-sm transition-all duration-300 group-hover:w-8 group-hover:opacity-40"></div>
        <div class="relative w-16 h-16">
          <% if (isSelected) { %>
            <div class="absolute inset-0 rounded-full border-[3px] border-orange-400 animate-ping-slow z-0 opacity-60"></div>
          <% } %>
          <div class="w-16 h-16 bg-slate-50 rounded-full border-[4px] shadow-lg overflow-hidden relative z-10 flex items-center justify-center transition-all duration-300 <%= isSelected ? 'border-orange-400 shadow-orange-500/50 shadow-xl' : 'border-white group-hover:border-orange-200 group-hover:shadow-orange-500/30' %>">
            <img src="https://api.dicebear.com/7.x/notionists/svg?seed=<%= p.avatarSeed %>&backgroundColor=f8fafc" alt="avatar" class="w-full h-full object-cover scale-110" />
          </div>
        </div>
        <div class="mt-3 backdrop-blur-md text-[10px] font-black px-3 py-1.5 rounded-xl whitespace-nowrap transition-all duration-300 shadow-sm border border-transparent <%= isSelected ? 'bg-orange-500 text-white opacity-100 border-orange-400 shadow-orange-500/40' : 'bg-slate-800/85 text-white opacity-80 group-hover:bg-orange-50 group-hover:text-orange-600 group-hover:opacity-100 group-hover:border-orange-200' %>">
          <span class="<%= isSelected ? 'opacity-90' : 'text-slate-300 group-hover:text-orange-400' %>"><%= p.age %>歳</span> <span class="mx-0.5 opacity-50">/</span> <%= p.role %>
        </div>
      </div>
    </div>
  <% }) %>

  <!-- 箱庭上の機能要件カードの配置 -->
  <% if (typeof requirements !== 'undefined' && requirements && requirements.length > 0) { %>
    <% requirements.forEach((req, idx) => { %>
      <%
        // 初期位置: ペルソナと重なりにくく、斜めに綺麗に整列するように散らす
        const initX = 35 + (idx % 3) * 16;
        const initY = 30 + Math.floor(idx / 3) * 18;
        
        // この要件に紐づくシミュレーション結果があるか確認
        let matchingSim = null;
        if (typeof simulations !== 'undefined' && simulations) {
          matchingSim = simulations.find(sim => sim.requirementId === req.id);
        }
        
        const isSelectedRequirement = selectedSimulation?.requirementId === req.id;
        const isThisRunning = isPolling && isSelectedRequirement;
        
        let cardBorderClass = 'border-white hover:shadow-[0_15px_40px_rgba(0,0,0,0.08)] bg-white/95';
        if (isThisRunning) {
          cardBorderClass = 'border-orange-300 shadow-[0_10px_30px_rgba(249,115,22,0.2)] bg-orange-50/95 animate-pulse';
        } else if (isSelectedRequirement) {
          cardBorderClass = 'border-orange-200 bg-white shadow-[0_10px_30px_rgba(249,115,22,0.15)]';
        } else {
          cardBorderClass += ' shadow-[0_8px_30px_rgba(0,0,0,0.06)]';
        }
      %>
      <div
        class="draggable-node absolute z-30 select-none cursor-grab active:cursor-grabbing border-[3px] p-4 rounded-[2rem] w-64 flex flex-col text-slate-800 transition-all duration-300 group/reqcard hover:-translate-y-1.5 <%= cardBorderClass %> overflow-hidden"
        style="left: <%= initX %>%; top: <%= initY %>%;"
        data-node-id="req-<%= req.id %>"
      >
        <!-- 装飾用グラデーション -->
        <div class="absolute -top-10 -right-10 w-24 h-24 bg-gradient-to-br from-orange-100/40 to-pink-100/40 rounded-full blur-xl group-hover/reqcard:scale-150 transition-transform duration-700 pointer-events-none"></div>

        <!-- ヘッダー -->
        <div class="flex items-start justify-between gap-1.5 mb-3 relative z-10">
          <div class="flex items-center gap-1.5 text-[9px] font-black text-orange-600 bg-orange-50 border border-orange-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
            <svg class="w-3.5 h-3.5 shrink-0 text-orange-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>機能要件</span>
          </div>
          <div class="flex items-center gap-2">
            <% if (isSelectedRequirement || isThisRunning) { %>
              <span class="flex h-2.5 w-2.5 relative shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-orange-500"></span>
              </span>
            <% } %>
            <button
              hx-patch="/<%= activeProject.id %>/action/sandbox/requirements/<%= encodeURIComponent(req.id) %>/hide"
              hx-target="#sandbox-characters" hx-swap="outerHTML"
              class="text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-100 transition-all active:scale-95"
              title="非表示にする">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <!-- タイトル -->
        <button
          class="text-left w-full transition-opacity focus:outline-none relative z-10 group-hover/reqcard:text-orange-600"
          hx-get="/<%= activeProject.id %>/view/requirements/<%= req.id %>"
          hx-target="#left-panel-content"
          hx-swap="innerHTML"
        >
          <h4 class="text-sm font-black text-slate-800 tracking-tight leading-snug mb-3 truncate transition-colors" title="<%= req.title %>">
            <%= req.title %>
          </h4>
        </button>

        <!-- 詳細アコーディオンエリア (普段は縮小) -->
        <div id="req-detail-<%= req.id %>" class="transition-all duration-300 max-h-0 opacity-0 overflow-y-auto text-[11px] text-slate-600 border-slate-100 flex flex-col gap-3 relative z-10" style="max-height: 0px; opacity: 0; border-top-width: 0px; margin-top: 0px; padding-top: 0px;">
          <div class="font-bold leading-relaxed whitespace-pre-wrap"><%= req.description %></div>
          <% if (req.acceptanceCriteria && req.acceptanceCriteria.length > 0) { %>
            <div class="border-t border-slate-100/60 pt-2.5">
              <span class="block text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1.5 font-mono">受け入れ基準</span>
              <ul class="space-y-1.5">
                <% req.acceptanceCriteria.forEach((crit) => { %>
                  <li class="flex gap-2 leading-relaxed">
                    <span class="text-orange-500 font-bold mt-0.5">•</span>
                    <span class="font-bold"><%= crit %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } %>
        </div>

        <!-- アコーディオン切り替えボタン -->
        <button
          type="button"
          onclick="toggleReqCardDetail(this, 'req-detail-<%= req.id %>')"
          class="w-full text-slate-400 hover:text-slate-600 text-[10px] font-black py-2 text-center border-t border-slate-100/80 hover:bg-slate-50 rounded-xl transition-all flex items-center justify-center gap-1.5 mt-2 mb-3 relative z-10 tracking-widest uppercase font-mono"
        >
          <span>詳細を表示</span>
          <svg class="w-3 h-3 transition-transform duration-300 transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
          </svg>
        </button>

        <!-- アクション -->
        <div class="mt-auto relative z-10">
          <% if (isThisRunning) { %>
            <!-- 実行中のインラインローディング表示 -->
            <div class="w-full bg-gradient-to-r from-orange-500 to-orange-600 text-white text-xs font-black py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-orange-500/30">
              <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="tracking-widest">検証中...</span>
            </div>
          <% } else if (matchingSim) { %>
            <button
              hx-get="/<%= activeProject.id %>/view/simulations/<%= encodeURIComponent(matchingSim.id) %>"
              hx-target="#left-panel-content"
              hx-swap="innerHTML"
              onclick="if(typeof htmx !== 'undefined') { htmx.ajax('GET', '/<%= activeProject.id %>/view/simulation-square?simulationId=<%= encodeURIComponent(matchingSim.id) %>', { target: '#sandbox-characters', swap: 'outerHTML' }); }"
              class="w-full text-[11px] font-black text-center py-2.5 px-4 rounded-xl border-2 transition-all active:scale-95 flex items-center justify-center gap-1.5
                <%= isSelectedRequirement ? 'bg-gradient-to-r from-orange-500 to-orange-600 text-white border-transparent shadow-lg shadow-orange-500/30' : 'bg-white text-slate-600 border-slate-100 hover:bg-orange-50 hover:text-orange-600 hover:border-orange-200' %>"
            >
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              <span><%= isSelectedRequirement ? '結果を表示中' : '結果を表示' %></span>
            </button>
          <% } else { %>
            <button
              hx-post="/<%= activeProject.id %>/action/simulate/run"
              hx-vals='{"requirementId": "<%= req.id %>"}'
              hx-target="#sandbox-characters"
              hx-swap="outerHTML"
              class="w-full bg-slate-800 hover:bg-slate-900 text-white text-[11px] font-black text-center py-2.5 px-4 rounded-xl active:scale-95 transition-all flex items-center justify-center gap-1.5 shadow-lg shadow-slate-800/20 hover:shadow-slate-900/30"
            >
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>シミュレーション実行</span>
            </button>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>

</div>

<script>
  (function() {
    function initializeDraggableNodes() {
      const dragNodes = document.querySelectorAll('.draggable-node');
      dragNodes.forEach(node => {
        // 二重登録を防止
        if (node.dataset.draggableInitialized) {
          // すでに初期化済みで、要件カードの位置が書き変わったかもしれないので位置のみ再復元
          const nodeId = node.dataset.nodeId;
          if (nodeId.startsWith('req-')) {
            const savedPos = sessionStorage.getItem('pos_' + nodeId);
            if (savedPos) {
              const { left, top } = JSON.parse(savedPos);
              node.style.left = left;
              node.style.top = top;
            }
          }
          return;
        }
        node.dataset.draggableInitialized = "true";

        let isDragging = false;
        let startX, startY, initLeft, initTop;
        let hasMoved = false;

        // セッションストレージなどから、ドラッグ位置を復元する（要件カードのみ）
        const nodeId = node.dataset.nodeId;
        if (nodeId.startsWith('req-')) {
          const savedPos = sessionStorage.getItem('pos_' + nodeId);
          if (savedPos) {
            const { left, top } = JSON.parse(savedPos);
            node.style.left = left;
            node.style.top = top;
          }
        }

        node.addEventListener('mousedown', (e) => {
          // ボタンのクリック時はドラッグしない
          if (e.target.closest('button, input, a, textarea')) return;
          
          isDragging = true;
          hasMoved = false;
          node.style.transition = 'none'; // ドラッグ中はトランジションを切る
          startX = e.clientX;
          startY = e.clientY;
          
          const rect = node.getBoundingClientRect();
          const parentRect = node.parentElement.getBoundingClientRect();
          initLeft = rect.left - parentRect.left;
          initTop = rect.top - parentRect.top;
          
          node.classList.remove('cursor-grab');
          node.classList.add('cursor-grabbing');
          
          // ドラッグ開始時にのみ window イベントを登録
          window.addEventListener('mousemove', onMouseMove);
          window.addEventListener('mouseup', onMouseUp);
          
          e.preventDefault();
        });

        function onMouseMove(e) {
          if (!isDragging) return;
          
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          
          if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
            hasMoved = true;
          }
          
          const parentRect = node.parentElement.getBoundingClientRect();
          let newLeft = initLeft + dx;
          let newTop = initTop + dy;
          
          let leftPercent, topPercent;
          if (nodeId.startsWith('persona-')) {
            // ペルソナは translate(-50%, -50%) がかかっているため、中心位置を基準に計算する
            const halfWidth = node.offsetWidth / 2;
            const halfHeight = node.offsetHeight / 2;
            newLeft = Math.max(-halfWidth, Math.min(newLeft, parentRect.width - halfWidth));
            newTop = Math.max(-halfHeight, Math.min(newTop, parentRect.height - halfHeight));
            leftPercent = ((newLeft + halfWidth) / parentRect.width) * 100 + '%';
            topPercent = ((newTop + halfHeight) / parentRect.height) * 100 + '%';
          } else {
            // 要件カードは translate がかかっていないため、左端を基準に計算する（右下のズレを防ぐ）
            newLeft = Math.max(0, Math.min(newLeft, parentRect.width - node.offsetWidth));
            newTop = Math.max(0, Math.min(newTop, parentRect.height - node.offsetHeight));
            leftPercent = (newLeft / parentRect.width) * 100 + '%';
            topPercent = (newTop / parentRect.height) * 100 + '%';
          }
          
          node.style.left = leftPercent;
          node.style.top = topPercent;
        }

        async function onMouseUp() {
          if (!isDragging) return;
          isDragging = false;
          
          node.style.transition = 'shadow 0.2s duration';
          node.classList.remove('cursor-grabbing');
          node.classList.add('cursor-grab');

          // イベントのクリーンアップ
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);

          if (!hasMoved) {
            // 純粋なクリック (ペルソナのみ詳細パネルを表示)
            if (nodeId.startsWith('persona-')) {
              const personaId = nodeId.replace('persona-', '');
              const projectId = node.dataset.projectId;
              const simulationId = node.dataset.simulationId;
              
              if (typeof htmx !== 'undefined') {
                htmx.ajax('GET', `/${projectId}/view/persona/${personaId}?simulationId=${encodeURIComponent(simulationId)}`, {
                  target: '#detail-panel',
                  swap: 'outerHTML'
                });
              }
            }
          } else {
            // ドラッグ完了
            const xVal = Math.round(parseFloat(node.style.left));
            const yVal = Math.round(parseFloat(node.style.top));
            
            if (nodeId.startsWith('persona-')) {
              // ペルソナの位置を DB に保存
              const personaId = nodeId.replace('persona-', '');
              const projectId = node.dataset.projectId;
              
              try {
                const res = await fetch(`/${projectId}/action/persona/${personaId}/position`, {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({ x: xVal, y: yVal })
                });
                if (!res.ok) {
                  console.error('Failed to update persona position in DB');
                }
              } catch (err) {
                console.error('Error updating persona position:', err);
              }
            } else if (nodeId.startsWith('req-')) {
              // 要件の位置をセッションに一時保存
              sessionStorage.setItem('pos_' + nodeId, JSON.stringify({ left: node.style.left, top: node.style.top }));
            }
          }
        }
      });
    }

    // アコーディオン開閉トグル用グローバル関数
    window.toggleReqCardDetail = function(btn, detailId) {
      const detail = document.getElementById(detailId);
      const icon = btn.querySelector('svg');
      const textSpan = btn.querySelector('span');
      
      if (detail.style.maxHeight === '240px') {
        detail.style.maxHeight = '0px';
        detail.style.opacity = '0';
        detail.style.marginTop = '0px';
        detail.style.paddingTop = '0px';
        detail.style.borderTopWidth = '0px';
        textSpan.textContent = '詳細を表示';
        icon.style.transform = 'rotate(0deg)';
      } else {
        detail.style.maxHeight = '240px';
        detail.style.opacity = '1';
        detail.style.marginTop = '8px';
        detail.style.paddingTop = '8px';
        detail.style.borderTopWidth = '1px';
        textSpan.textContent = '詳細を閉じる';
        icon.style.transform = 'rotate(180deg)';
      }
    };

    // 初回初期化
    initializeDraggableNodes();

    // HTMX による DOM 置換や OOB swap 後に自動で再アタッチする
    if (typeof htmx !== 'undefined') {
      document.body.addEventListener('htmx:afterSettle', initializeDraggableNodes);
      document.body.addEventListener('htmx:load', initializeDraggableNodes);
    }
  })();
</script>
