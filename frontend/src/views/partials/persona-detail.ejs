<aside id="detail-panel" hx-swap-oob="true" class="w-[360px] bg-white border-l border-slate-200 z-30 flex flex-col shrink-0 overflow-y-auto" style="display: flex;">
  <!-- Detail Panel Header -->
  <div class="h-10 flex items-center justify-between px-6 border-b border-slate-100 bg-white shrink-0">
    <h2 class="text-sm font-bold text-slate-800 flex items-center">ペルソナ詳細</h2>
    <button 
      hx-get="/<%= activeProject.id %>/view/persona/close?simulationId=<%= typeof selectedSimulation !== 'undefined' && selectedSimulation ? selectedSimulation.id : '' %>" 
      hx-target="#detail-panel" 
      hx-swap="outerHTML"
      class="text-slate-400 hover:text-slate-600 bg-slate-50 hover:bg-slate-100 rounded-full p-1.5 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <!-- Detail Content -->
  <div class="p-6">
    <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 relative overflow-hidden group">
      <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-orange-100/60 to-transparent rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-110"></div>
      
      <div class="flex justify-between items-start mb-2">
        <span class="text-xs font-bold text-orange-500 bg-orange-50 px-2 py-1 rounded-md"><%= p.role %></span>
      </div>

      <div class="flex flex-col items-center mb-6 mt-2">
        <div class="relative mb-4">
          <div class="w-14 h-14 rounded-full border-4 border-white shadow-md overflow-hidden bg-slate-100 relative z-10 flex items-center justify-center">
            <img src="https://api.dicebear.com/7.x/notionists/svg?seed=<%= p.avatarSeed %>&backgroundColor=f8fafc" alt="<%= p.name %>" class="w-full h-full object-cover scale-110" />
          </div>
          <div class="absolute inset-0 rounded-full border border-orange-200 scale-110 -z-0"></div>
        </div>
        <h2 class="text-lg font-bold text-slate-800 flex items-baseline gap-2"><%= p.name %> <span class="text-sm font-normal text-slate-500">(<%= p.age %>歳)</span></h2>
      </div>

      <div class="mb-6">
        <h3 class="text-xs font-bold text-slate-700 mb-3 flex items-center uppercase tracking-wider">
          <svg class="w-[0.875rem] h-[0.875rem] text-orange-500 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> 特徴
        </h3>
        <div class="flex flex-wrap gap-2">
          <% p.traits.forEach(t => { %>
            <span class="px-3 py-1.5 bg-slate-50 text-slate-600 rounded-full text-[10px] font-medium border border-slate-200"><%= t %></span>
          <% }) %>
        </div>
      </div>

      <div class="mb-6">
        <h3 class="text-xs font-bold text-slate-700 mb-3 flex items-center uppercase tracking-wider">
          <svg class="w-[0.875rem] h-[0.875rem] text-blue-500 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> 背景・課題
        </h3>
        <p class="text-xs text-slate-600 leading-relaxed ml-2 whitespace-pre-wrap"><%= p.background %></p>
      </div>

      <% if (p.sourceDocumentIds && p.sourceDocumentIds.length > 0) { %>
        <div class="mb-6">
          <h3 class="text-xs font-bold text-slate-700 mb-3 uppercase tracking-wider">参照資料</h3>
          <div class="flex flex-wrap gap-2">
            <% p.sourceDocumentIds.forEach((documentId) => { %>
              <span class="px-2 py-1 bg-blue-50 text-blue-700 rounded-md text-[10px] border border-blue-100"><%= documentId %></span>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (typeof reaction !== 'undefined' && reaction && reaction.status === 'completed') { %>
        <!-- シミュレーション結果セクション -->
        <div class="mt-6 border-t border-slate-100 pt-6 animate-fade-in">
          <%
            let sentimentLabel = 'ニュートラル';
            let sentimentBadgeClass = 'bg-slate-50 text-slate-700 border-slate-200';
            let sentimentIcon = '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            if (reaction.sentiment === 'positive') {
              sentimentLabel = 'ポジティブ';
              sentimentBadgeClass = 'bg-green-50 text-green-700 border-green-200';
              sentimentIcon = '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            } else if (reaction.sentiment === 'negative') {
              sentimentLabel = 'ネガティブ';
              sentimentBadgeClass = 'bg-red-50 text-red-700 border-red-200';
              sentimentIcon = '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            }
          %>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xs font-bold text-slate-700 flex items-center uppercase tracking-wider">
              <svg class="w-4 h-4 text-orange-500 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-6m4 6V7m4 10v-3M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
              シミュレーション反応
            </h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border <%= sentimentBadgeClass %>">
              <%- sentimentIcon %><%= sentimentLabel %>
            </span>
          </div>

          <!-- 所感（2行程度） -->
          <div class="mb-4 bg-slate-50 rounded-2xl p-4 border border-slate-100">
            <div class="text-[10px] font-bold text-slate-400 uppercase mb-2">所感（2行程度）</div>
            <p class="text-xs text-slate-600 leading-relaxed font-medium"><%= reaction.shortFeedback %></p>
          </div>

          <!-- 詳しい所感 -->
          <div class="mb-4 bg-slate-50 rounded-2xl p-4 border border-slate-100">
            <div class="text-[10px] font-bold text-slate-400 uppercase mb-2">詳しい所感</div>
            <p class="text-xs text-slate-600 leading-relaxed font-medium whitespace-pre-wrap"><%= reaction.detailedFeedback %></p>
          </div>

          <!-- 業務での活用イメージ -->
          <div class="mb-4 bg-slate-50 rounded-2xl p-4 border border-slate-100">
            <div class="text-[10px] font-bold text-slate-400 uppercase mb-2">業務での活用イメージ</div>
            <p class="text-xs text-slate-600 leading-relaxed font-medium whitespace-pre-wrap"><%= reaction.workImage %></p>
          </div>

          <!-- 懸念点 -->
          <% if (reaction.concerns && reaction.concerns.length > 0) { %>
            <div class="mb-4">
              <div class="flex items-center gap-1.5 mb-1.5">
                <svg class="w-3.5 h-3.5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <h4 class="text-[10px] font-bold text-slate-700 uppercase tracking-wide">懸念点</h4>
              </div>
              <ul class="space-y-1 pl-5 list-disc text-slate-600">
                <% reaction.concerns.forEach(item => { %>
                  <li class="text-[11px] leading-relaxed"><%= item %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
        </div>
      <% } %>

    </div>
  </div>

  <!-- Action -->
  <div class="mt-auto p-6 bg-white border-t border-slate-100">
    <button hx-post="/<%= activeProject.id %>/action/chat/persona/<%= p.id %>" class="w-full flex items-center justify-center text-sm font-bold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 py-3 rounded-xl shadow-sm transition-colors group">
      このペルソナと個別にチャット
    </button>
  </div>
</aside>
