<aside id="detail-panel" hx-swap-oob="true"
  class="w-[360px] bg-[#f8fafc] border-l border-slate-200 z-30 flex flex-col shrink-0 overflow-y-auto"
  style="display: flex;">
  <!-- Detail Panel Header -->
  <div class="h-14 flex items-center justify-between px-6 border-b border-slate-100 bg-white shrink-0 shadow-sm z-10">
    <button
      hx-get="/<%= activeProject.id %>/view/persona/close?simulationId=<%= typeof selectedSimulation !== 'undefined' && selectedSimulation ? selectedSimulation.id : '' %>"
      hx-target="#detail-panel" hx-swap="outerHTML"
      onclick="document.cookie = 'selectedPersonaId=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC;';"
      class="text-slate-400 hover:text-slate-600 bg-transparent hover:bg-slate-100 rounded-full p-2 transition-all duration-200 active:scale-95">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Detail Content -->
  <div class="p-6">
    <div class="bg-white rounded-[2rem] border-[3px] border-white p-6 shadow-[0_8px_30px_rgba(0,0,0,0.04)] relative overflow-hidden group">
      <!-- デコレーション背景 -->
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-gradient-to-br from-orange-100/40 to-pink-100/40 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none"></div>

      <div class="flex justify-between items-start mb-2 relative z-10">
        <span class="text-[10px] font-black text-orange-600 bg-orange-50 border border-orange-200 px-2.5 py-1 rounded-full uppercase tracking-wider">
          <%= p.role %>
        </span>
      </div>

      <div class="flex flex-col items-center mb-6 mt-4 relative z-10">
        <div class="relative mb-5">
          <div class="w-16 h-16 rounded-full border-4 border-white shadow-lg shadow-orange-500/10 overflow-hidden bg-slate-50 relative z-10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <img src="https://api.dicebear.com/7.x/<%= (p.avatarSeed && p.avatarSeed.toLowerCase().includes('female')) ? 'lorelei' : 'notionists' %>/svg?seed=<%= p.avatarSeed %>&backgroundColor=f8fafc"
              alt="<%= p.name %>" class="w-full h-full object-cover scale-110" />
          </div>
          <div class="absolute inset-0 rounded-full border border-orange-300 scale-125 -z-0 opacity-50"></div>
          <div class="absolute inset-0 rounded-full border border-orange-200 scale-150 -z-0 opacity-20 animate-ping-slow"></div>
        </div>
        <h2 class="text-xl font-black text-slate-800 flex items-baseline gap-2 tracking-tight">
          <%= p.name %> <span class="text-xs font-bold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full"><%= p.age %>歳</span>
        </h2>
      </div>

      <div class="mb-6 relative z-10">
        <h3 class="text-[10px] font-black text-slate-400 mb-3 flex items-center uppercase tracking-widest font-mono">
          <svg class="w-3.5 h-3.5 text-orange-400 mr-1.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg> 
          特徴
        </h3>
        <div class="flex flex-wrap gap-2">
          <% p.traits.forEach(t=> { %>
            <span class="px-3 py-1.5 bg-slate-50 text-slate-600 rounded-full text-[10px] font-bold border border-slate-200 hover:bg-orange-50 hover:text-orange-600 hover:border-orange-200 transition-colors shadow-sm">
              <%= t %>
            </span>
          <% }) %>
        </div>
      </div>

      <div class="mb-6 relative z-10">
        <h3 class="text-[10px] font-black text-slate-400 mb-3 flex items-center uppercase tracking-widest font-mono">
          <svg class="w-3.5 h-3.5 text-blue-400 mr-1.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg> 
          背景・課題
        </h3>
        <p class="text-xs text-slate-600 leading-relaxed font-medium whitespace-pre-wrap"><%= p.background %></p>
      </div>

      <% if (p.sourceDocumentIds && p.sourceDocumentIds.length > 0) { %>
        <div class="mb-6 relative z-10">
          <h3 class="text-[10px] font-black text-slate-400 mb-3 uppercase tracking-widest font-mono">参照資料</h3>
          <div class="flex flex-wrap gap-2">
            <% p.sourceDocumentIds.forEach((documentId)=> { %>
              <% 
                let docName = documentId;
                if (typeof sourceDocuments !== 'undefined') {
                  const doc = sourceDocuments.find(d => d.id === documentId);
                  if (doc) docName = doc.reference;
                }
              %>
              <span class="px-2.5 py-1 bg-blue-50 text-blue-600 rounded-lg text-[10px] font-bold border border-blue-100 shadow-sm flex items-center gap-1">
                <svg class="w-3 h-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                </svg>
                <%= docName %>
              </span>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (typeof reaction !== 'undefined' && reaction && reaction.status === 'completed') { %>
        <!-- シミュレーション結果セクション -->
        <div class="mt-8 border-t border-slate-100 pt-6 animate-fade-in relative z-10">
          <%
            let sentimentLabel = 'ニュートラル';
            let sentimentBadgeClass = 'bg-slate-50 text-slate-700 border-slate-200';
            let sentimentIcon = '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            if (reaction.sentiment === 'positive') {
              sentimentLabel = 'ポジティブ';
              sentimentBadgeClass = 'bg-green-50 text-green-700 border-green-200';
              sentimentIcon = '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            } else if (reaction.sentiment === 'negative') {
              sentimentLabel = 'ネガティブ';
              sentimentBadgeClass = 'bg-red-50 text-red-700 border-red-200';
              sentimentIcon = '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            }
          %>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-[11px] font-black text-slate-800 flex items-center uppercase tracking-widest font-mono">
              <svg class="w-4 h-4 text-orange-500 mr-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg> 
              シミュレーション結果
            </h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border <%= sentimentBadgeClass %>">
              <%- sentimentIcon %><%= sentimentLabel %>
            </span>
          </div>

          <!-- 期待・懸念・改善案のリスト -->
          <div class="bg-gradient-to-br from-orange-50 to-amber-50/50 p-5 rounded-[1.5rem] border border-orange-100/60 shadow-inner mb-4">
            <div class="space-y-4">
              <% [ 
                ['詳しい所感', [reaction.detailedFeedback], 'text-emerald-600', '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>'], 
                ['業務での活用イメージ', [reaction.workImage], 'text-blue-500', '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>'], 
                ['懸念点', reaction.concerns, 'text-red-500', '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>'] 
              ].forEach(([title, items, iconColor, pathSvg])=> { %>
                <% if (items && items.length > 0) { %>
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <svg class="w-4 h-4 <%= iconColor %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <%- pathSvg %>
                      </svg>
                      <h4 class="text-[10px] font-black text-slate-700 uppercase tracking-wide">
                        <%= title %>
                      </h4>
                    </div>
                    <ul class="space-y-1.5 pl-6 list-disc text-slate-700">
                      <% items.forEach(item=> { %>
                        <li class="text-[11px] font-bold leading-relaxed">
                          <%= item %>
                        </li>
                      <% }) %>
                    </ul>
                  </div>
                <% } %>
              <% }) %>
            </div>
          </div>

          <!-- 全体フィードバック (総評) -->
          <div class="bg-white rounded-2xl p-4 border-[2px] border-slate-100 shadow-sm relative overflow-hidden">
            <div class="absolute -right-4 -bottom-4 text-slate-50 opacity-50">
              <svg class="w-20 h-20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.714 4.032-8.118 7.983-9.609l-1.025-3c-4.484 1.354-10.975 4.908-10.975 12.609v7.391h4.017zm-14.017 0v-7.391c0-5.714 4.032-8.118 7.983-9.609l-1.025-3c-4.484 1.354-10.975 4.908-10.975 12.609v7.391h4.017z"></path>
              </svg>
            </div>
            <div class="text-[10px] font-black text-slate-400 uppercase mb-2 relative z-10 tracking-widest font-mono">総評</div>
            <p class="text-xs text-slate-700 leading-relaxed font-bold relative z-10">
              <%= reaction.shortFeedback %>
            </p>

        </div>
      <% } %>

    </div>
  </div>
</aside>