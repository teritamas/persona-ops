<div class="flex-1 flex flex-col h-full bg-white relative">
  <div id="chat-messages-scroll" class="flex-1 bg-slate-50/30 p-4 overflow-y-auto flex flex-col relative">
    <div id="chat-messages-container" class="space-y-2 w-full h-full flex flex-col">
      <% if (!activeChat || !activeChat.messages || activeChat.messages.length === 0) { %>
        <div id="welcome-message-wrapper" class="max-w-3xl mx-auto w-full flex flex-col items-center animate-fade-in py-10 mt-auto mb-auto">
          <div class="w-20 h-20 bg-gradient-to-br from-orange-400 to-orange-500 rounded-[2rem] flex items-center justify-center text-white font-bold mb-8 shadow-xl shadow-orange-500/30">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          </div>
          <h2 class="text-3xl font-extrabold text-slate-800 mb-4 tracking-tight">PersonaOps へようこそ</h2>
          <p class="text-slate-500 text-center mb-10 max-w-lg leading-relaxed font-medium">
            ユーザーインタビューや要件定義書などのドキュメントを共有して、あなたのプロダクトを利用する「仮想ペルソナ群」を構築しましょう。
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
            <button onclick="submitSuggestion(this)" data-text="先週のユーザーインタビュー議事録と、既存SFAの仕様書をアップロードします。これをもとにペルソナを作成してください。" type="button" class="flex items-start text-left w-full bg-white border border-slate-200 hover:border-orange-300 hover:bg-orange-50 p-4 rounded-xl transition-all active:scale-95 shadow-sm group">
              <div class="shrink-0 mt-0.5 mr-3 bg-slate-50 group-hover:bg-white p-2 rounded-lg border border-slate-100 transition-colors">
                <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
              </div>
              <span class="text-sm text-slate-600 font-medium leading-relaxed group-hover:text-orange-700 transition-colors">
                先週のユーザーインタビュー議事録と、既存仕様書からペルソナを作成する
              </span>
            </button>
            <button onclick="submitSuggestion(this)" data-text="GitHubのIssue URLを共有します。これをもとにエンジニアペルソナを作成してください。" type="button" class="flex items-start text-left w-full bg-white border border-slate-200 hover:border-orange-300 hover:bg-orange-50 p-4 rounded-xl transition-all active:scale-95 shadow-sm group">
              <div class="shrink-0 mt-0.5 mr-3 bg-slate-50 group-hover:bg-white p-2 rounded-lg border border-slate-100 transition-colors">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
              </div>
              <span class="text-sm text-slate-600 font-medium leading-relaxed group-hover:text-orange-700 transition-colors">
                GitHubのIssue URLを読み込んで、エンジニアペルソナを生成する
              </span>
            </button>
          </div>
        </div>
      <% } else { %>
        <div class="text-center text-xs text-slate-400 font-medium my-4 shrink-0">Today</div>
        <% (activeChat.messages || []).forEach(msg => { %>
          <%- include('chat-message', { msg, activeProject }) %>
        <% }) %>
      <% } %>
    </div>
  </div>
    
  <!-- Input Form -->
  <div class="p-4 bg-white border-t border-slate-100 shrink-0">
    <form 
      id="chat-form"
      onsubmit="<%= (typeof isWelcome !== 'undefined' && isWelcome) ? 'startFirstProject(event)' : 'submitStreamChat(event)' %>"
      class="w-full flex flex-col bg-slate-100 rounded-3xl border border-transparent focus-within:border-orange-200 focus-within:bg-white focus-within:ring-4 focus-within:ring-orange-500/10 transition-all shadow-inner shadow-slate-200/50 p-2"
    >
      <!-- Textarea Area -->
      <div class="w-full relative">
        <textarea 
          id="inputText"
          name="inputText"
          rows="1"
          placeholder="AIへの指示を入力... (Shift + Enter で改行)"
          class="w-full bg-transparent text-slate-800 text-sm py-2 px-3 resize-none overflow-hidden block min-h-[40px] max-h-[200px] focus:outline-none"
          required
          oninput="this.style.height = 'auto'; this.style.height = (this.scrollHeight) + 'px';"
          onkeydown="if(event.key === 'Enter' && !event.shiftKey && !event.isComposing) { event.preventDefault(); this.form.requestSubmit(); }"
        ></textarea>
      </div>

      <!-- Bottom Toolbar Area -->
      <div class="flex items-center justify-between mt-1 px-1">
        <div></div>

        <!-- Right side: Send button -->
        <button type="submit" class="bg-slate-800 text-white p-2 rounded-full hover:bg-slate-900 hover:shadow-md transition-all active:scale-95 flex items-center justify-center h-8 w-8 shadow-sm border border-transparent">
          <svg class="w-4 h-4 ml-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"></path></svg>
        </button>
      </div>
    </form>
  </div>
</div>
