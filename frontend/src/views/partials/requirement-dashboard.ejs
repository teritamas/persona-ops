<div id="requirement-dashboard"
  class="flex-1 min-h-0 flex flex-col bg-slate-50 overflow-hidden animate-fade-in text-slate-800"
  hx-get="/<%= activeProject.id %>/view/requirements"
  hx-trigger="refreshRequirementDashboard from:body"
  hx-target="#requirement-dashboard"
  hx-swap="outerHTML"
>

  <% 
    const currentMode = typeof mode !== 'undefined' ? mode : 'view'; 
  %>

  <% if (currentMode === 'new') { %>
    <div id="requirement-detail-container" class="flex-1 min-h-0 overflow-y-auto p-6 bg-[#f8fafc] scroll-smooth animate-fade-in">
      <% 
        const emptyRequirement = {
          id: '',
          title: '',
          description: '',
          acceptanceCriteria: [],
        };
      %>
      <%- include('requirement-edit-form', { activeProject, requirement: emptyRequirement, isNew: true }) %>
    </div>
  <% } else if (currentMode === 'edit' && selectedRequirement) { %>
    <div id="requirement-detail-container" class="flex-1 min-h-0 overflow-y-auto p-6 bg-[#f8fafc] scroll-smooth animate-fade-in">
      <%- include('requirement-edit-form', { activeProject, requirement: selectedRequirement }) %>
    </div>
  <% } else if (requirements.length === 0) { %>
    <div class="flex-1 flex items-center justify-center p-8 bg-[#f8fafc]">
      <div class="flex flex-col items-center justify-center py-16 px-12 bg-white rounded-[32px] border-2 border-dashed border-slate-200/80 group hover:border-orange-300 hover:bg-orange-50/30 transition-all duration-300">
        <div class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-12 transition-transform duration-300 shadow-sm">
          <svg class="w-10 h-10 text-amber-500 animate-pulse" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <p class="text-base font-black text-slate-700 mb-2">登録されている要件はありません</p>
        <p class="text-xs font-bold text-slate-400 text-center leading-relaxed max-w-[240px]">
          機能要件を作成するか、チャットにてAIアシスタントに要件定義を依頼してください。
        </p>

      </div>
    </div>
  <% } else { %>
    <!-- 下部: 要件詳細・編集エリア -->
    <div id="requirement-detail-container" class="flex-1 min-h-0 overflow-y-auto p-6 bg-[#f8fafc] scroll-smooth">
      <% if (selectedRequirement) { %>
        <div class="mx-auto space-y-4 animate-fade-in">
          <section class="bg-white rounded-[2rem] border-[3px] border-white p-7 shadow-[0_8px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_15px_40px_rgba(249,115,22,0.08)] hover:-translate-y-1.5 transition-all duration-500 group relative overflow-hidden">
            <!-- デコレーション背景 -->
            <div class="absolute -top-16 -right-16 w-40 h-40 bg-gradient-to-br from-pink-100/50 to-orange-100/50 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none"></div>

            <div class="flex flex-wrap items-start justify-between gap-4 mb-6 relative z-10">
              <div class="flex items-center gap-3 flex-wrap">
                <!-- バージョン切り替え dropdown -->
                <% if (typeof versions !== 'undefined' && versions && versions.length > 0) { %>
                  <div class="flex items-center gap-1">
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Ver:</span>
                    <select 
                      name="version" 
                      hx-get="/<%= activeProject.id %>/view/requirements/<%= latestRequirement.id %>?version=" 
                      hx-trigger="change"
                      hx-target="#requirement-dashboard" 
                      hx-swap="outerHTML"
                      hx-vals='js:{version: event.target.value}'
                      class="bg-slate-50 text-slate-600 text-[11px] font-bold px-2 py-0.5 rounded-lg border border-slate-200 focus:outline-none focus:border-orange-300">
                      <% versions.forEach(v => { %>
                        <option value="<%= v.version %>" <%= selectedRequirement.version === v.version ? 'selected' : '' %>>
                          v<%= v.version %> (<%= v.status === 'approved' ? '承認済' : 'ドラフト' %>) <%= v.version === latestRequirement.version ? '(最新)' : '' %>
                        </option>
                      <% }) %>
                    </select>
                  </div>
                <% } %>

                <% if (typeof isPastVersion !== 'undefined' && isPastVersion) { %>
                  <span class="rounded-full border px-2 py-0.5 text-[10px] font-bold bg-purple-50 text-purple-700 border-purple-200 flex items-center gap-1">
                    過去バージョン (v<%= selectedRequirement.version %>)
                  </span>
                <% } else if (selectedRequirement.status === 'approved') { %>
                  <span class="rounded-full border px-2 py-0.5 text-[10px] font-bold bg-green-50 text-green-700 border-green-200 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
                    </svg>
                    承認済み
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">開発者がMCPから参照できます</span>
                <% } else { %>
                  <span class="rounded-full border px-2 py-0.5 text-[10px] font-bold bg-amber-50 text-amber-700 border-amber-200 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    ドラフト
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">承認することで開発者がMCPから参照できるようになります</span>
                <% } %>
              </div>
              <div class="flex items-center gap-2">
                <% if (typeof isPastVersion !== 'undefined' && isPastVersion) { %>
                  <button hx-post="/<%= activeProject.id %>/action/requirements/<%= latestRequirement.id %>/versions/<%= selectedRequirement.version %>/restore"
                    hx-target="#requirement-dashboard" hx-swap="outerHTML"
                    class="bg-purple-600 hover:bg-purple-750 border border-purple-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5">
                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L12 9L15 15"></path>
                    </svg>
                    <span>このバージョンを復元</span>
                  </button>
                <% } else { %>
                  <% if (selectedRequirement.status === 'draft') { %>
                    <button hx-patch="/<%= activeProject.id %>/action/requirements/<%= selectedRequirement.id %>/approve"
                      hx-target="#requirement-dashboard" hx-swap="outerHTML"
                      class="bg-green-600 hover:bg-green-750 border border-green-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5">
                      <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
                      </svg>
                      <span>承認する</span>
                    </button>
                  <% } %>
                  <button hx-get="/<%= activeProject.id %>/view/requirements/<%= selectedRequirement.id %>/edit"
                    hx-target="#requirement-detail-container" hx-swap="innerHTML"
                    hx-push-url="/<%= activeProject.id %>/requirements/<%= selectedRequirement.id %>/edit"
                    class="bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5">
                    <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" stroke-width="2"
                      viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                      </path>
                    </svg>
                    <span>編集</span>
                  </button>
                  <button hx-delete="/<%= activeProject.id %>/action/requirements/<%= selectedRequirement.id %>"
                    hx-target="#requirement-dashboard" hx-swap="outerHTML"
                    hx-confirm="この要件を削除しますか？関連するシミュレーション結果もすべて削除されます。"
                    class="bg-white hover:bg-red-50 border border-red-200 text-red-500 hover:text-red-700 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5"
                    title="要件を削除">
                    <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" stroke-width="2"
                      viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                      </path>
                    </svg>
                    <span>削除</span>
                  </button>
                <% } %>
              </div>
            </div>

            <!-- タイトル -->
            <h3 class="text-2xl font-black text-slate-800 mb-4 tracking-tight relative z-10">
              <%= selectedRequirement.title %>
            </h3>
            <p class="max-w-3xl text-sm leading-6 text-slate-600 mb-6 relative z-10 whitespace-pre-wrap"><%= selectedRequirement.description %></p>

            <% if (selectedRequirement.sourceDocumentIds && selectedRequirement.sourceDocumentIds.length > 0) { %>
              <div class="mb-6 relative z-10">
                <p class="mb-2 text-[10px] font-bold text-slate-400 uppercase tracking-wider">参照資料</p>
                <div class="flex flex-wrap gap-2">
                  <% selectedRequirement.sourceDocumentIds.forEach((documentId)=> { %>
                    <% 
                      let docName = documentId;
                      if (typeof sourceDocuments !== 'undefined') {
                        const doc = sourceDocuments.find(d => d.id === documentId);
                        if (doc) docName = doc.reference;
                      }
                    %>
                    <span class="rounded-lg border border-blue-100 bg-blue-50 px-2.5 py-1 text-[10px] font-bold text-blue-700 flex items-center gap-1 shadow-sm">
                      <svg class="w-3 h-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                      </svg>
                      <%= docName %>
                    </span>
                  <% }) %>
                </div>
              </div>
            <% } %>



            <% if (selectedRequirement.acceptanceCriteria && selectedRequirement.acceptanceCriteria.length > 0) { %>
              <!-- 受け入れ基準ボックス -->
              <div class="mb-2 bg-gradient-to-br from-orange-50 to-amber-50/50 p-5 rounded-[1.5rem] border border-orange-100/60 shadow-inner relative z-10">
                <h4 class="text-[10px] font-black text-orange-800/60 mb-2.5 uppercase tracking-widest font-mono">受け入れ基準</h4>
                <div class="space-y-3">
                  <% selectedRequirement.acceptanceCriteria.forEach((criterion)=> { %>
                    <div class="flex items-start gap-3">
                      <div class="w-2.5 h-2.5 rounded-full bg-orange-400 mt-1.5 shrink-0 shadow-sm shadow-orange-400/50"></div>
                      <p class="text-xs text-slate-700 font-bold leading-relaxed">
                        <%= criterion %>
                      </p>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
             <!-- 日付情報（右下に移動、バッジ風の枠線を廃止） -->
             <div class="flex justify-end mt-6">
               <div class="text-[10px] text-slate-400 font-mono relative z-10">
                 更新: <%= new Date(selectedRequirement.updatedAt).toLocaleString('ja-JP', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
               </div>
             </div>
           </section>

           <%- include('requirement-simulation-result', { activeProject, selectedRequirement, selectedSimulation: typeof selectedSimulation !== 'undefined' ? selectedSimulation : null }) %>
         </div>
      <% } else { %>
        <div class="h-full flex items-center justify-center text-xs font-bold text-slate-400">
          要件を選択してください
        </div>
      <% } %>
    </div>
  <% } %>
</div>