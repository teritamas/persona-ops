<div id="requirement-dashboard"
  class="flex-1 flex flex-col h-full bg-slate-50 overflow-hidden animate-fade-in text-slate-800">


  <% if (requirements.length===0) { %>
    <div class="flex-1 flex items-center justify-center p-8">
      <div class="max-w-md text-center">
        <div class="mx-auto h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center">
          <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
            </path>
          </svg>
        </div>
        <h3 class="mt-4 text-sm font-bold text-slate-700">登録されている要件はありません</h3>
        <p class="mt-2 text-xs leading-5 text-slate-500">
          機能要件を作成するか、チャットにてAIアシスタントに要件定義を依頼してください。
        </p>
        <button hx-get="/<%= activeProject.id %>/view/requirements/new-form" hx-target="#requirement-detail-container"
          hx-swap="innerHTML"
          class="mt-4 bg-slate-800 hover:bg-slate-900 text-white px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5 mx-auto">
          最初の要件を作成
        </button>
      </div>
    </div>
    <% } else { %>
      <!-- 下部: 要件詳細・編集エリア -->
      <div id="requirement-detail-container" class="flex-1 min-h-0 overflow-y-auto p-4 bg-slate-50">
        <% if (selectedRequirement) { %>
          <div class="mx-auto space-y-4 animate-fade-in">
            <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
              <div class="flex flex-col gap-3">
                <div class="flex items-start justify-between">
                  <h3 class="text-sm font-bold text-slate-800 leading-tight">
                    <%= selectedRequirement.title %>
                  </h3>
                </div>

                <p class="text-xs leading-5 text-slate-600 whitespace-pre-wrap">
                  <%= selectedRequirement.description %>
                </p>

                <% if (selectedRequirement.sourceDocumentIds && selectedRequirement.sourceDocumentIds.length> 0) { %>
                  <div class="mt-2">
                    <p class="mb-1.5 text-[10px] font-bold text-slate-500">参照資料</p>
                    <div class="flex flex-wrap gap-1.5">
                      <% selectedRequirement.sourceDocumentIds.forEach((documentId)=> { %>
                        <span class="rounded-md border border-blue-100 bg-blue-50 px-2 py-0.5 text-[9px] text-blue-700">
                          <%= documentId %>
                        </span>
                        <% }) %>
                    </div>
                  </div>
                  <% } %>

                    <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100">
                      <div class="text-[9px] text-slate-400">
                        更新: <%= new Date(selectedRequirement.updatedAt).toLocaleString('ja-JP', { month: 'short' ,
                          day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                      </div>
                      <div class="flex items-center gap-2">
                        <button hx-get="/<%= activeProject.id %>/view/requirements/<%= selectedRequirement.id %>/edit"
                          hx-target="#requirement-detail-container" hx-swap="innerHTML"
                          class="bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5">
                          <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" stroke-width="2"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                            </path>
                          </svg>
                          <span>編集</span>
                        </button>
                        <button hx-delete="/<%= activeProject.id %>/action/requirements/<%= selectedRequirement.id %>"
                          hx-target="#requirement-dashboard" hx-swap="outerHTML"
                          hx-confirm="この要件を削除しますか？関連するシミュレーション結果もすべて削除されます。"
                          class="bg-white hover:bg-red-50 border border-red-200 text-red-500 hover:text-red-700 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5"
                          title="要件を削除">
                          <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" stroke-width="2"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                            </path>
                          </svg>
                          <span>削除</span>
                        </button>
                      </div>
                    </div>
              </div>

              <% if (selectedRequirement.acceptanceCriteria && selectedRequirement.acceptanceCriteria.length> 0) { %>
                <div class="mt-4 border-t border-slate-100 pt-4">
                  <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">受け入れ基準</h4>
                  <ul class="space-y-1.5">
                    <% selectedRequirement.acceptanceCriteria.forEach((criterion)=> { %>
                      <li class="flex gap-2 text-[11px] leading-relaxed text-slate-600">
                        <span class="mt-1 text-orange-500 shrink-0 text-[8px]">●</span>
                        <span>
                          <%= criterion %>
                        </span>
                      </li>
                      <% }) %>
                  </ul>
                </div>
                <% } %>
            </section>
          </div>
          <% } else { %>
            <div class="h-full flex items-center justify-center text-xs text-slate-400">
              要件を選択してください
            </div>
            <% } %>
      </div>
      <% } %>
</div>