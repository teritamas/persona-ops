<div id="requirement-dashboard" class="flex-1 flex flex-col h-full bg-slate-50 overflow-hidden animate-fade-in text-slate-800">
  <!-- ヘッダー -->
  <header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0 shadow-sm">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-orange-50 text-orange-500 rounded-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
      <h2 class="text-base font-extrabold text-slate-800">要件定義ダッシュボード</h2>
    </div>
    
    <button 
      hx-get="/<%= activeProject.id %>/requirements/new-form"
      hx-target="#requirement-detail-container"
      hx-swap="innerHTML"
      class="flex items-center gap-1.5 bg-orange-500 hover:bg-orange-600 active:scale-95 text-white text-xs font-bold py-2 px-3.5 rounded-xl transition-all shadow-md shadow-orange-500/10"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
      </svg>
      <span>要件を新規作成</span>
    </button>
  </header>

  <% if (requirements.length === 0) { %>
    <div class="flex-1 flex items-center justify-center p-8">
      <div class="max-w-md text-center">
        <div class="mx-auto h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center">
          <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-sm font-bold text-slate-700">登録されている要件はありません</h3>
        <p class="mt-2 text-xs leading-5 text-slate-500">
          機能要件を作成するか、チャットにてAIアシスタントに要件定義を依頼してください。
        </p>
        <button 
          hx-get="/<%= activeProject.id %>/requirements/new-form"
          hx-target="#requirement-detail-container"
          hx-swap="innerHTML"
          class="mt-4 bg-orange-500 hover:bg-orange-600 active:scale-95 text-white font-bold text-xs py-2 px-4 rounded-xl transition-all"
        >
          最初の要件を作成
        </button>
      </div>
    </div>
  <% } else { %>
    <div class="flex-1 min-h-0 grid grid-cols-[280px_minmax(0,1fr)]">
      <!-- 左サイドバー: 要件リスト -->
      <aside id="req-history-scroll" class="min-h-0 overflow-y-auto border-r border-slate-200 bg-white p-3">
        <div class="space-y-2">
          <% requirements.forEach((requirement) => { %>
            <div class="relative group/reqcard w-full animate-fade-in">
              <button
                hx-get="/<%= activeProject.id %>/view/requirements/<%= requirement.id %>"
                hx-target="#requirement-dashboard"
                hx-swap="outerHTML"
                class="w-full rounded-xl border p-3 pr-10 text-left transition-colors <%= requirement.id === selectedRequirement?.id ? 'border-orange-300 bg-orange-50/60' : 'border-slate-200 bg-white hover:bg-slate-50' %>">
                <p class="line-clamp-2 text-xs font-bold leading-5 text-slate-700">
                  <%= requirement.title %>
                </p>
                <p class="mt-2 text-[9px] text-slate-400">
                  最終更新: <%= new Date(requirement.updatedAt).toLocaleDateString('ja-JP') %>
                </p>
              </button>

              <!-- ホバーアクション（削除） -->
              <div class="absolute top-2 right-2 opacity-0 group-hover/reqcard:opacity-100 flex items-center gap-1 transition-opacity duration-150">
                <button
                  hx-delete="/<%= activeProject.id %>/requirements/<%= requirement.id %>"
                  hx-target="#requirement-dashboard"
                  hx-swap="outerHTML"
                  hx-confirm="この要件を削除しますか？関連するシミュレーション結果もすべて削除されます。"
                  class="p-1.5 hover:bg-red-50 border border-slate-200 hover:border-red-200 text-slate-400 hover:text-red-500 rounded-lg active:scale-95 bg-white shadow-sm transition-all"
                  title="要件を削除"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </aside>

      <!-- 右側: 要件詳細・編集エリア -->
      <div id="requirement-detail-container" class="min-h-0 overflow-y-auto p-6">
        <% if (selectedRequirement) { %>
          <div class="mx-auto max-w-4xl space-y-5 animate-fade-in">
            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-lg font-bold text-slate-800">
                    <%= selectedRequirement.title %>
                  </h3>
                  <p class="mt-4 text-sm leading-6 text-slate-600 whitespace-pre-wrap"><%= selectedRequirement.description %></p>
                </div>
                <div class="text-right text-[10px] leading-5 text-slate-400 shrink-0">
                  <div>最終更新: <%= new Date(selectedRequirement.updatedAt).toLocaleString('ja-JP') %></div>
                  <div class="mt-3">
                    <button
                      hx-get="/<%= activeProject.id %>/requirements/<%= selectedRequirement.id %>/edit"
                      hx-target="#requirement-detail-container"
                      hx-swap="innerHTML"
                      class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-800 border border-slate-200 hover:bg-slate-50 rounded-xl active:scale-95 transition-all shadow-sm bg-white"
                    >
                      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                      </svg>
                      <span>要件を編集</span>
                    </button>
                  </div>
                </div>
              </div>

              <% if (selectedRequirement.acceptanceCriteria && selectedRequirement.acceptanceCriteria.length > 0) { %>
                <div class="mt-6 border-t border-slate-100 pt-5">
                  <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">受け入れ基準 (Acceptance Criteria)</h4>
                  <ul class="space-y-2">
                    <% selectedRequirement.acceptanceCriteria.forEach((criterion) => { %>
                      <li class="flex gap-2.5 text-xs leading-5 text-slate-600 font-medium">
                        <span class="mt-1 text-orange-500 shrink-0">●</span>
                        <span><%= criterion %></span>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              <% } %>
            </section>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
