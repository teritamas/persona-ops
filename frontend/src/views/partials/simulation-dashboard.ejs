<% const selectedId=selectedSimulation?.id; const pollingPath=!followLatest && selectedId ?
  `/${activeProject.id}/view/simulations/${encodeURIComponent(selectedId)}` : `/${activeProject.id}/view/simulations`;
  %>
  <section id="simulation-dashboard" class="flex-1 min-h-0 flex flex-col bg-slate-50">

    <% if (simulations.length===0) { %>
      <div class="flex-1 flex items-center justify-center p-8">
        <div class="max-w-md text-center">
          <div class="mx-auto h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M9 17v-6m4 6V7m4 10v-3M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z">
              </path>
            </svg>
          </div>
          <h3 class="mt-4 text-sm font-bold text-slate-700">シミュレーション履歴はありません</h3>
          <p class="mt-2 text-xs leading-5 text-slate-500">
            チャットで要件を作成・承認すると、実行状況と結果がここに表示されます。
          </p>
        </div>
      </div>
      <% } else { %>
        <div id="sim-detail-scroll" class="flex-1 min-h-0 overflow-y-auto p-4 bg-slate-50">
          <div class="mx-auto space-y-4">
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2">
                    <div class="flex items-center gap-3">
                      <span
                        class="rounded-full border px-2 py-0.5 text-xs font-bold <%= selectedSimulation.badgeClass %>">
                        <%= selectedSimulation.label %>
                      </span>
                      <button
                        hx-delete="/<%= activeProject.id %>/action/simulations/<%= encodeURIComponent(selectedSimulation.id) %>"
                        hx-target="#simulation-dashboard" hx-swap="outerHTML" hx-confirm="このシミュレーション結果を削除しますか？"
                        class="bg-white hover:bg-red-50 border border-red-200 text-red-500 hover:text-red-700 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5"
                        title="結果を削除">
                        <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                          </path>
                        </svg>
                        <span>削除</span>
                      </button>
                    </div>
                  </div>
                  <h3 class="mt-3 text-lg font-bold text-slate-800">
                    <%= selectedSimulation.requirementSnapshot.title %>
                  </h3>
                  <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
                    <%= selectedSimulation.requirementSnapshot.description %>
                  </p>
                </div>
                <div class="text-right text-[11px] leading-5 text-slate-400">
                  <div>開始: <%= selectedSimulation.displayCreatedAt %>
                  </div>
                  <div>完了: <%= selectedSimulation.displayCompletedAt %>
                  </div>
                </div>
              </div>

              <div class="mt-5 border-t border-slate-100 pt-4">
                <h4 class="text-xs font-bold text-slate-700">受け入れ基準</h4>
                <ul class="mt-2 space-y-2">
                  <% selectedSimulation.requirementSnapshot.acceptanceCriteria.forEach((criterion)=> { %>
                    <li class="flex gap-2 text-xs leading-5 text-slate-600">
                      <span class="mt-1 text-orange-500">●</span>
                      <span>
                        <%= criterion %>
                      </span>
                    </li>
                    <% }) %>
                </ul>
              </div>
            </section>

            <section>
              <div class="mb-3 flex items-center justify-between">
                <h4 class="text-sm font-bold text-slate-800">ペルソナの反応</h4>
                <div class="flex gap-3 text-[11px]">
                  <span class="text-emerald-600">positive <%= selectedSimulation.summary.positiveCount %></span>
                  <span class="text-slate-500">neutral <%= selectedSimulation.summary.neutralCount %></span>
                  <span class="text-red-600">negative <%= selectedSimulation.summary.negativeCount %></span>
                </div>
              </div>

              <% if (selectedSimulation.reactions.length===0) { %>
                <div
                  class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
                  <%= ['queued', 'running' ].includes(selectedSimulation.status) ? 'シミュレーションを実行しています。完了すると反応が表示されます。'
                    : '保存されたペルソナ反応はありません。' %>
                </div>
                <% } %>

                  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm">
                    <% selectedSimulation.reactions.forEach((reaction, index)=> { %>
                      <article
                        class="flex items-start p-4 <%= index % 2 !== 0 ? 'bg-slate-50/50' : 'bg-white' %> border-b border-slate-100 last:border-b-0">
                        <!-- Avatar & Name -->
                        <div class="w-20 shrink-0 flex flex-col items-center">
                          <div
                            class="w-10 h-10 rounded-full border border-slate-200 overflow-hidden bg-slate-100 flex items-center justify-center">
                            <img
                              src="https://api.dicebear.com/7.x/notionists/svg?seed=<%= reaction.personaSnapshot.avatarSeed || reaction.personaSnapshot.id %>&backgroundColor=f8fafc"
                              class="w-full h-full object-cover scale-110" alt="<%= reaction.personaSnapshot.name %>" />
                          </div>
                          <span class="mt-2 text-[10px] font-bold text-slate-500 text-center leading-tight">
                            <%= reaction.personaSnapshot.name %>
                          </span>
                        </div>

                        <!-- Reaction Content -->
                        <div class="flex-1 pl-4 flex flex-col justify-center min-h-[40px]">
                          <% if (reaction.status==='completed' ) { %>
                            <% 
                              let iconColor = 'text-slate-600 bg-slate-100 border-slate-200';
                              let iconSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
                              if (reaction.sentiment === 'positive') {
                                iconColor = 'text-green-600 bg-green-100 border-green-200';
                                iconSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
                              } else if (reaction.sentiment === 'negative') {
                                iconColor = 'text-red-600 bg-red-100 border-red-200';
                                iconSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
                              } 
                            %>
                            <div class="mb-1.5 p-1 rounded-full border w-max <%- iconColor %>"><%- iconSvg %></div>
                              <p class="text-xs text-slate-700 font-medium leading-relaxed">
                                <%= reaction.shortFeedback %>
                              </p>
                              <% } else { %>
                                <span
                                  class="inline-block rounded-full border border-red-200 bg-red-50 px-2 py-1 text-[10px] font-bold text-red-700 w-max">
                                  生成失敗: <%= reaction.errorCode %>
                                </span>
                                <% } %>
                        </div>
                      </article>
                      <% }) %>
                  </div>
            </section>
          </div>
        </div>
        <% } %>
  </section>