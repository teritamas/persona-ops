<% const selectedId=selectedSimulation?.id; const pollingPath=!followLatest && selectedId ?
  `/${activeProject.id}/view/simulations/${encodeURIComponent(selectedId)}` : `/${activeProject.id}/view/simulations`;
  %>
  <section id="simulation-dashboard" class="flex-1 min-h-0 flex flex-col bg-slate-50">

    <% if (simulations.length===0) { %>
      <div class="flex-1 flex items-center justify-center p-8 bg-[#f8fafc]">
        <div
          class="flex flex-col items-center justify-center py-16 px-12 bg-white rounded-[32px] border-2 border-dashed border-slate-200/80 group hover:border-orange-300 hover:bg-orange-50/30 transition-all duration-300">
          <div
            class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-12 transition-transform duration-300 shadow-sm">
            <svg class="w-10 h-10 text-amber-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 21h6m-3-3v3m-3-6a3 3 0 01-3-3 3.5 3.5 0 013.5-3.5h0A3.5 3.5 0 0115 12a3 3 0 01-3 3z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z">
              </path>
            </svg>
          </div>
          <p class="text-base font-black text-slate-700 mb-2">シミュレーションはありません</p>
          <p class="text-xs font-bold text-slate-400 text-center leading-relaxed">
            チャットで要件を作成し、シュミレーションを実行すると実行状況と結果がここに表示されます。</p>
        </div>
      </div>
      <% } else { %>
        <div id="sim-detail-scroll" class="flex-1 min-h-0 overflow-y-auto p-6 space-y-8 bg-[#f8fafc] scroll-smooth">

          <div class="mx-auto space-y-4">
            <section
              class="bg-white rounded-[2rem] border-[3px] border-white p-7 shadow-[0_8px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_15px_40px_rgba(249,115,22,0.08)] hover:-translate-y-1.5 transition-all duration-500 group relative overflow-hidden">

              <!-- デコレーション背景 -->
              <div
                class="absolute -top-16 -right-16 w-40 h-40 bg-gradient-to-br from-pink-100/50 to-orange-100/50 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none">
              </div>

              <div class="flex flex-wrap items-start justify-between gap-4 mb-6 relative z-10">
                <div class="flex items-center gap-3">
                  <span class="rounded-full border px-2 py-0.5 text-xs font-bold <%= selectedSimulation.badgeClass %>">
                    <%= selectedSimulation.label %>
                  </span>
                </div>
                <button
                  hx-delete="/<%= activeProject.id %>/action/simulations/<%= encodeURIComponent(selectedSimulation.id) %>"
                  hx-target="#simulation-dashboard" hx-swap="outerHTML" hx-confirm="このシミュレーション結果を削除しますか？"
                  class="bg-white hover:bg-red-50 border border-red-200 text-red-500 hover:text-red-700 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5"
                  title="結果を削除">
                  <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                    </path>
                  </svg>
                  削除
                </button>
              </div>

              <!-- タイトル -->
              <h3
                class="text-2xl font-black text-slate-800 mb-4 tracking-tight relative z-10">
                <%= selectedSimulation.requirementSnapshot.title %>
              </h3>
              <p class="max-w-3xl text-sm leading-6 text-slate-600 mb-6 relative z-10">
                <%= selectedSimulation.requirementSnapshot.description %>
              </p>

              <!-- 日付情報 -->
              <div
                class="text-[10px] text-slate-400 font-mono space-y-1.5 mb-6 bg-slate-50 p-3 rounded-xl border border-slate-100 inline-block relative z-10">
                <p>開始: <%= selectedSimulation.displayCreatedAt %>
                </p>
                <p>完了: <%= selectedSimulation.displayCompletedAt %>
                </p>
              </div>

              <!-- 受け入れ基準ボックス -->
              <div
                class="mb-8 bg-gradient-to-br from-orange-50 to-amber-50/50 p-5 rounded-[1.5rem] border border-orange-100/60 shadow-inner relative z-10">
                <h4 class="text-[10px] font-black text-orange-800/60 mb-2.5 uppercase tracking-widest font-mono">受け入れ基準
                </h4>
                <div class="space-y-3">
                  <% selectedSimulation.requirementSnapshot.acceptanceCriteria.forEach((criterion)=> { %>
                    <div class="flex items-start gap-3">
                      <div
                        class="w-2.5 h-2.5 rounded-full bg-orange-400 mt-1.5 shrink-0 shadow-sm shadow-orange-400/50">
                      </div>
                      <p class="text-xs text-slate-700 font-bold leading-relaxed">
                        <%= criterion %>
                      </p>
                    </div>
                    <% }) %>
                </div>
              </div>
            </section>

            <section
              class="bg-white rounded-[2rem] border-[3px] border-white p-7 shadow-[0_8px_30px_rgba(0,0,0,0.04)] relative z-10">
              <div class="flex justify-between items-end mb-4 border-b-2 border-slate-50 pb-4">
                <h4 class="font-black text-slate-800 text-sm flex items-center gap-2">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                    </path>
                  </svg>
                  ペルソナの反応
                </h4>
                <div class="flex gap-2 text-[10px] font-black font-mono tracking-wide">
                  <span class="text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-100 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= selectedSimulation.summary.positiveCount %>
                  </span>
                  <span class="text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= selectedSimulation.summary.neutralCount %>
                  </span>
                  <span class="text-rose-500 bg-rose-50 px-2.5 py-1 rounded-lg border border-rose-100 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= selectedSimulation.summary.negativeCount %>
                  </span>
                </div>
              </div>

              <% if (selectedSimulation.reactions.length===0) { %>
                <div
                  class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
                  <%= ['queued', 'running' ].includes(selectedSimulation.status) ? 'シミュレーションを実行しています。完了すると反応が表示されます。'
                    : '保存されたペルソナ反応はありません。' %>
                </div>
                <% } %>

                  <div class="flex flex-col gap-3">
                    <% selectedSimulation.reactions.forEach((reaction, index)=> { %>
                      <article
                        hx-get="/<%= activeProject.id %>/view/persona/<%= encodeURIComponent(reaction.personaSnapshot.id) %>?simulationId=<%= encodeURIComponent(selectedSimulation.id) %>"
                        hx-target="#detail-panel"
                        hx-swap="outerHTML"
                        class="cursor-pointer flex items-start gap-4 p-3.5 rounded-[1.5rem] border border-transparent hover:border-orange-100 hover:bg-gradient-to-r hover:from-orange-50 hover:to-pink-50/30 transition-all duration-300 group/item hover:shadow-sm">
                        <!-- Avatar & Name -->
                        <div class="flex flex-col items-center shrink-0 w-16 relative">
                          <div class="relative">
                            <div
                              class="w-14 h-14 rounded-full border-2 border-white shadow-sm bg-white overflow-hidden flex items-center justify-center relative z-10 group-hover/item:scale-110 group-hover/item:rotate-6 transition-transform duration-300 group-hover/item:shadow-orange-200">
                              <img
                                src="https://api.dicebear.com/7.x/notionists/svg?seed=<%= reaction.personaSnapshot.avatarSeed || reaction.personaSnapshot.id %>&backgroundColor=transparent"
                                class="w-12 h-12 object-contain" alt="<%= reaction.personaSnapshot.name %>" />
                            </div>
                          </div>
                          <span
                            class="text-[10px] font-black text-slate-600 mt-2.5 truncate w-full text-center group-hover/item:text-orange-600 transition-colors">
                            <%= reaction.personaSnapshot.name %>
                          </span>
                        </div>

                        <!-- Reaction Content -->
                        <div class="flex-1 flex flex-col justify-center min-h-[40px] pt-1.5">
                          <% if (reaction.status==='completed' ) { %>
                            <% let iconColor='text-slate-600 bg-slate-100 border-slate-200' ; let
                              iconSvg='<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>'
                              ; if (reaction.sentiment==='positive' ) {
                              iconColor='text-green-600 bg-green-100 border-green-200' ;
                              iconSvg='<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>'
                              ; } else if (reaction.sentiment==='negative' ) {
                              iconColor='text-red-600 bg-red-100 border-red-200' ;
                              iconSvg='<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>'
                              ; } %>
                              <div class="mb-1.5 p-1 rounded-full border w-max <%- iconColor %>"><%- iconSvg %></div>
                              <p class="text-[13px] text-slate-700 font-bold leading-relaxed">
                                <% 
                                  let fb = reaction.shortFeedback;
                                  if (!fb || fb === 'undefined') fb = reaction.detailedFeedback;
                                  if (!fb || fb === 'undefined') fb = '（フィードバック内容がありません）';
                                %>
                                <%= fb %>
                              </p>
                              <% } else { %>
                                <span
                                  class="inline-block rounded-full border border-red-200 bg-red-50 px-2 py-1 text-[10px] font-bold text-red-700 w-max">
                                  生成失敗: <%= reaction.errorCode %>
                                </span>
                                <% } %>
                        </div>
                      </article>
                      <% }) %>
                  </div>
            </section>
          </div>
        </div>
        <% } %>
  </section>