<%
  const selectedId = selectedSimulation?.id;
  const pollingPath = !followLatest && selectedId
    ? `/${activeProject.id}/view/simulations/${encodeURIComponent(selectedId)}`
    : `/${activeProject.id}/view/simulations`;
%>
<section id="simulation-dashboard"
  class="flex-1 min-h-0 flex flex-col bg-slate-50"
  hx-get="<%= pollingPath %>"
  hx-trigger="every 5s"
  hx-target="#simulation-dashboard"
  hx-swap="outerHTML">
  <header class="h-14 shrink-0 border-b border-slate-200 bg-white px-6 flex items-center justify-between">
    <div>
      <h2 class="text-sm font-bold text-slate-800">シミュレーション結果</h2>
      <p class="text-[11px] text-slate-400">5秒ごとに最新状態へ更新</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-xs text-slate-500"><%= simulations.length %>件</span>
      <a href="/"
        class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-50">
        箱庭に戻る
      </a>
    </div>
  </header>

  <% if (simulations.length === 0) { %>
    <div class="flex-1 flex items-center justify-center p-8">
      <div class="max-w-md text-center">
        <div class="mx-auto h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center">
          <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M9 17v-6m4 6V7m4 10v-3M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z">
            </path>
          </svg>
        </div>
        <h3 class="mt-4 text-sm font-bold text-slate-700">シミュレーション履歴はありません</h3>
        <p class="mt-2 text-xs leading-5 text-slate-500">
          チャットで要件を作成・承認すると、実行状況と結果がここに表示されます。
        </p>
      </div>
    </div>
  <% } else { %>
    <div class="flex-1 min-h-0 grid grid-cols-[280px_minmax(0,1fr)]">
      <aside id="sim-history-scroll" class="min-h-0 overflow-y-auto border-r border-slate-200 bg-white p-3">
        <div class="space-y-2">
          <% simulations.forEach((simulation, index) => { %>
            <button
              hx-get="/<%= activeProject.id %>/view/simulations/<%= encodeURIComponent(simulation.id) %>"
              hx-target="#simulation-dashboard"
              hx-swap="outerHTML"
              class="w-full rounded-xl border p-3 text-left transition-colors <%= simulation.id === selectedId ? 'border-orange-300 bg-orange-50/60' : 'border-slate-200 bg-white hover:bg-slate-50' %>">
              <div class="flex items-start justify-between gap-2">
                <span class="text-[10px] font-bold uppercase tracking-wide text-slate-400">
                  <%= index === 0 ? '最新' : `履歴 ${index + 1}` %>
                </span>
                <span class="rounded-full border px-2 py-0.5 text-[10px] font-bold <%= simulation.badgeClass %>">
                  <%= simulation.label %>
                </span>
              </div>
              <p class="mt-2 line-clamp-2 text-xs font-bold leading-5 text-slate-700">
                <%= simulation.requirementSnapshot.title %>
              </p>
              <p class="mt-2 text-[10px] text-slate-400"><%= simulation.displayCreatedAt %></p>
              <div class="mt-2 flex gap-3 text-[10px] text-slate-500">
                <span>成功 <strong class="text-emerald-600"><%= simulation.successCount %></strong></span>
                <span>失敗 <strong class="text-red-600"><%= simulation.failureCount %></strong></span>
              </div>
            </button>
          <% }) %>
        </div>
      </aside>

      <div id="sim-detail-scroll" class="min-h-0 overflow-y-auto p-6">
        <div class="mx-auto max-w-5xl space-y-5">
          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="rounded-full border px-2.5 py-1 text-[11px] font-bold <%= selectedSimulation.badgeClass %>">
                    <%= selectedSimulation.label %>
                  </span>
                  <span class="font-mono text-[10px] text-slate-400"><%= selectedSimulation.id %></span>
                </div>
                <h3 class="mt-3 text-lg font-bold text-slate-800">
                  <%= selectedSimulation.requirementSnapshot.title %>
                </h3>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
                  <%= selectedSimulation.requirementSnapshot.description %>
                </p>
              </div>
              <div class="text-right text-[11px] leading-5 text-slate-400">
                <div>開始: <%= selectedSimulation.displayCreatedAt %></div>
                <div>完了: <%= selectedSimulation.displayCompletedAt %></div>
                <div>要件 version <%= selectedSimulation.requirementVersion %></div>
              </div>
            </div>

            <div class="mt-5 border-t border-slate-100 pt-4">
              <h4 class="text-xs font-bold text-slate-700">受け入れ基準</h4>
              <ul class="mt-2 space-y-2">
                <% selectedSimulation.requirementSnapshot.acceptanceCriteria.forEach((criterion) => { %>
                  <li class="flex gap-2 text-xs leading-5 text-slate-600">
                    <span class="mt-1 text-orange-500">●</span>
                    <span><%= criterion %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          </section>

          <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-white p-4">
              <div class="text-[10px] font-bold text-slate-400">成功ペルソナ</div>
              <div class="mt-1 text-2xl font-bold text-emerald-600">
                <%= selectedSimulation.successCount %><span class="ml-1 text-xs text-slate-400">/ <%= selectedSimulation.targetCount %></span>
              </div>
            </div>
            <% [
              ['価値', selectedSimulation.summary.averageValueScore],
              ['採用意向', selectedSimulation.summary.averageAdoptionIntentScore],
              ['業務適合', selectedSimulation.summary.averageWorkflowFitScore],
            ].forEach(([label, score]) => { %>
              <div class="rounded-xl border border-slate-200 bg-white p-4">
                <div class="text-[10px] font-bold text-slate-400"><%= label %> 平均</div>
                <div class="mt-1 text-2xl font-bold text-slate-800">
                  <%= score ?? '—' %><span class="ml-1 text-xs text-slate-400">/ 5</span>
                </div>
              </div>
            <% }) %>
          </section>

          <section>
            <div class="mb-3 flex items-center justify-between">
              <h4 class="text-sm font-bold text-slate-800">ペルソナの反応</h4>
              <div class="flex gap-3 text-[11px]">
                <span class="text-emerald-600">positive <%= selectedSimulation.summary.positiveCount %></span>
                <span class="text-slate-500">neutral <%= selectedSimulation.summary.neutralCount %></span>
                <span class="text-red-600">negative <%= selectedSimulation.summary.negativeCount %></span>
              </div>
            </div>

            <% if (selectedSimulation.reactions.length === 0) { %>
              <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
                <%= ['queued', 'running'].includes(selectedSimulation.status)
                  ? 'シミュレーションを実行しています。完了すると反応が表示されます。'
                  : '保存されたペルソナ反応はありません。' %>
              </div>
            <% } %>

            <div class="space-y-3">
              <% selectedSimulation.reactions.forEach((reaction) => { %>
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h5 class="text-sm font-bold text-slate-800"><%= reaction.personaSnapshot.name %></h5>
                      <p class="text-[11px] text-slate-400"><%= reaction.personaSnapshot.role %></p>
                    </div>
                    <% if (reaction.status === 'completed') { %>
                      <div class="flex gap-2 text-[10px] font-bold">
                        <span class="rounded bg-slate-100 px-2 py-1">価値 <%= reaction.valueScore %></span>
                        <span class="rounded bg-slate-100 px-2 py-1">採用 <%= reaction.adoptionIntentScore %></span>
                        <span class="rounded bg-slate-100 px-2 py-1">適合 <%= reaction.workflowFitScore %></span>
                      </div>
                    <% } else { %>
                      <span class="rounded-full border border-red-200 bg-red-50 px-2 py-1 text-[10px] font-bold text-red-700">
                        生成失敗: <%= reaction.errorCode %>
                      </span>
                    <% } %>
                  </div>

                  <% if (reaction.status === 'completed') { %>
                    <p class="mt-4 text-sm leading-6 text-slate-700"><%= reaction.feedback %></p>
                    <div class="mt-4 grid gap-4 lg:grid-cols-3">
                      <% [
                        ['期待する効果', reaction.benefits],
                        ['懸念点', reaction.concerns],
                        ['改善案', reaction.suggestedChanges],
                      ].forEach(([label, items]) => { %>
                        <div>
                          <h6 class="text-[10px] font-bold uppercase tracking-wide text-slate-400"><%= label %></h6>
                          <% if (items.length === 0) { %>
                            <p class="mt-2 text-xs text-slate-400">なし</p>
                          <% } else { %>
                            <ul class="mt-2 space-y-1">
                              <% items.forEach((item) => { %>
                                <li class="text-xs leading-5 text-slate-600">・<%= item %></li>
                              <% }) %>
                            </ul>
                          <% } %>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </article>
              <% }) %>
            </div>
          </section>
        </div>
      </div>
    </div>
  <% } %>
</section>
