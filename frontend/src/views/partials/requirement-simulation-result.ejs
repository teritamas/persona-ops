<% if (typeof selectedSimulation !== 'undefined' && selectedSimulation) { %>
  <% if (['running', 'queued'].includes(selectedSimulation.status)) { %>
    <!-- シミュレーション実行中 / 実行待ち状態 -->
    <div class="mt-6 bg-orange-50/40 rounded-[2rem] border-2 border-orange-100 p-6 flex flex-col items-center justify-center gap-3 shadow-inner relative z-10 animate-pulse">
      <svg class="animate-spin h-8 w-8 text-orange-500" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-xs font-black text-orange-600 tracking-wider">シミュレーション実行中...</span>
      <p class="text-[10px] text-orange-400 font-bold">進捗: <%= selectedSimulation.successCount %> / <%= selectedSimulation.targetCount %> 人完了</p>
    </div>
  <% } else { %>
    <!-- シミュレーション完了状態 -->
    <div class="mt-6 space-y-4 relative z-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 成功ペルソナカード -->
        <div class="bg-white rounded-[2rem] border-[3px] border-white p-5 shadow-[0_8px_30px_rgba(0,0,0,0.04)] bg-gradient-to-br from-emerald-50/20 to-white flex flex-col justify-center min-h-[120px]">
          <div class="text-[9px] font-black text-emerald-600/80 tracking-widest font-mono uppercase">成功ペルソナ</div>
          <div class="mt-1.5 text-3xl font-black text-emerald-600 flex items-baseline gap-1">
            <%= selectedSimulation.successCount %><span class="text-sm text-emerald-600/60">/ <%= selectedSimulation.targetCount %></span>
          </div>
        </div>

        <!-- 反応カード（サマリー） -->
        <div class="bg-white rounded-[2rem] border-[3px] border-white p-5 shadow-[0_8px_30px_rgba(0,0,0,0.04)] flex flex-col justify-center min-h-[120px]">
          <div class="text-[9px] font-black text-slate-400/85 tracking-widest font-mono uppercase mb-2">ペルソナの反応</div>
          <div class="flex flex-wrap gap-1.5 text-[10px] font-black font-mono">
            <span class="text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-xl border border-emerald-100 flex items-center gap-1 shrink-0" title="ポジティブ">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <%= selectedSimulation.summary.positiveCount %>
            </span>
            <span class="text-slate-500 bg-slate-100 px-2 py-0.5 rounded-xl border border-slate-200 flex items-center gap-1 shrink-0" title="ニュートラル">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <%= selectedSimulation.summary.neutralCount %>
            </span>
            <span class="text-rose-500 bg-rose-50 px-2 py-0.5 rounded-xl border border-rose-100 flex items-center gap-1 shrink-0" title="ネガティブ">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <%= selectedSimulation.summary.negativeCount %>
            </span>
          </div>
        </div>
      </div>

      <!-- 反応カード（詳細リスト） -->
      <section class="bg-white rounded-[2rem] border-[3px] border-white p-6 shadow-[0_8px_30px_rgba(0,0,0,0.04)] relative z-10">
        <h4 class="font-black text-slate-800 text-xs mb-4 border-b border-slate-50 pb-3">ペルソナの反応一覧</h4>
        
        <% if (selectedSimulation.reactions.length === 0) { %>
          <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
            保存されたペルソナ反応はありません。
          </div>
        <% } else { %>
          <div class="flex flex-col gap-3">
            <% selectedSimulation.reactions.forEach((reaction, index) => { %>
              <article
                hx-get="/<%= activeProject.id %>/view/persona/<%= encodeURIComponent(reaction.personaSnapshot.id) %>?simulationId=<%= encodeURIComponent(selectedSimulation.id) %>"
                hx-target="#detail-panel"
                hx-swap="outerHTML"
                onclick="document.getElementById('detail-panel').classList.remove('hidden');"
                class="cursor-pointer flex items-start gap-4 p-3 rounded-[1.5rem] border border-transparent hover:border-orange-100 hover:bg-gradient-to-r hover:from-orange-50 hover:to-pink-50/30 transition-all duration-300 group/item hover:shadow-sm">
                <!-- Avatar -->
                <div class="flex flex-col items-center shrink-0 w-12 relative">
                  <div class="w-10 h-10 rounded-full border-2 border-white shadow-sm bg-white overflow-hidden flex items-center justify-center relative z-10 group-hover/item:scale-110 transition-transform duration-300">
                    <img src="https://api.dicebear.com/7.x/<%= (reaction.personaSnapshot.avatarSeed && reaction.personaSnapshot.avatarSeed.toLowerCase().includes('female')) ? 'lorelei' : 'notionists' %>/svg?seed=<%= reaction.personaSnapshot.avatarSeed || reaction.personaSnapshot.id %>&backgroundColor=transparent" class="w-9 h-9 object-contain" alt="" />
                  </div>
                  <span class="text-[9px] font-black text-slate-500 mt-1.5 truncate w-full text-center group-hover/item:text-orange-600 transition-colors">
                    <%= reaction.personaSnapshot.name %>
                  </span>
                </div>

                <!-- Feedback -->
                <div class="flex-1 flex flex-col justify-center min-h-[36px] pt-1">
                  <% if (reaction.status === 'completed') { %>
                    <% 
                      let iconColor = 'text-slate-600 bg-slate-100 border-slate-200';
                      let iconSvg = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
                      if (reaction.sentiment === 'positive') {
                        iconColor = 'text-green-600 bg-green-100 border-green-200';
                        iconSvg = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
                      } else if (reaction.sentiment === 'negative') {
                        iconColor = 'text-red-600 bg-red-100 border-red-200';
                        iconSvg = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
                      }
                    %>
                    <div class="flex items-center gap-2 mb-1">
                      <div class="p-0.5 rounded-full border <%- iconColor %>"><%- iconSvg %></div>
                      <span class="text-[9px] font-bold uppercase tracking-wider <%- reaction.sentiment === 'positive' ? 'text-green-600' : reaction.sentiment === 'negative' ? 'text-red-600' : 'text-slate-500' %>"><%= reaction.sentiment %></span>
                    </div>
                    <p class="text-xs text-slate-700 leading-relaxed font-bold">
                      <%= reaction.shortFeedback || reaction.detailedFeedback || '（フィードバックなし）' %>
                    </p>
                  <% } else { %>
                    <span class="inline-block rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-[9px] font-bold text-red-700 w-max">
                      生成失敗: <%= reaction.errorCode %>
                    </span>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  <% } %>
<% } else { %>
  <!-- シミュレーション未実施状態 -->
  <div class="mt-6 bg-white rounded-[2rem] border-[3px] border-white p-7 shadow-[0_8px_30px_rgba(0,0,0,0.04)] flex flex-col items-center justify-center gap-4 relative z-10 animate-fade-in">
    <div class="w-16 h-16 bg-orange-50 rounded-full flex items-center justify-center">
      <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-6m4 6V7m4 10v-3M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
      </svg>
    </div>
    <div class="text-center">
      <h4 class="text-sm font-black text-slate-700 mb-1">シミュレーション未実施</h4>
      <p class="text-[10px] text-slate-400 font-bold max-w-[280px] leading-relaxed">
        この要件定義のバージョンはシミュレーションがまだ実行されていません。
      </p>
    </div>
    <button 
      hx-post="/<%= activeProject.id %>/action/requirements/<%= selectedRequirement.id %>/simulate"
      hx-target="#requirement-dashboard"
      hx-swap="outerHTML"
      class="bg-slate-800 hover:bg-slate-900 text-white text-xs font-black py-2.5 px-6 rounded-xl active:scale-95 transition-all flex items-center gap-1.5 shadow-md shadow-slate-800/20">
      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span>シミュレーションを実行する</span>
    </button>
  </div>
<% } %>
