<section id="simulation-dashboard"
  class="flex-1 flex items-center justify-center bg-slate-50 p-8">
  <div class="max-w-md rounded-2xl border border-red-200 bg-white p-6 text-center shadow-sm">
    <h2 class="text-base font-bold text-red-700">シミュレーション結果を表示できません</h2>
    <p class="mt-2 text-sm text-slate-600"><%= message %></p>
    <button hx-get="/view/simulations" hx-target="#simulation-playground" hx-swap="innerHTML"
      class="mt-4 rounded-lg bg-slate-800 px-4 py-2 text-xs font-bold text-white hover:bg-slate-700">
      再読み込み
    </button>
  </div>
</section>
