<div id="requirement-card-<%= requirement.id %>" class="bg-white border border-slate-200 hover:border-slate-300 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col relative group/reqcard">
  <!-- バッジ & アクション -->
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex flex-col gap-1.5">
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-bold text-slate-800 tracking-tight leading-none"><%= requirement.title %></h3>
        
        <!-- ステータスバッジ -->
        <% if (requirement.status === 'approved') { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 shadow-sm">
            承認済み
          </span>
        <% } else { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-100 shadow-sm">
            下書き
          </span>
        <% } %>
      </div>
      
      <!-- 最終更新日 -->
      <span class="text-[10px] text-slate-400 font-medium leading-none">
        最終更新: <%= new Date(requirement.updatedAt).toLocaleString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) %>
      </span>
    </div>

    <!-- アクションボタン（削除 & 編集） -->
    <div class="opacity-0 group-hover/reqcard:opacity-100 flex items-center gap-1 transition-all duration-200">
      <button
        hx-delete="/<%= activeProject.id %>/requirements/<%= requirement.id %>"
        hx-target="#requirement-card-<%= requirement.id %>"
        hx-swap="outerHTML"
        hx-confirm="この要件を削除しますか？関連するシミュレーション結果もすべて削除されます。"
        class="p-1.5 hover:bg-red-50 border border-transparent hover:border-red-200 text-slate-400 hover:text-red-500 rounded-lg active:scale-95 transition-all"
        title="要件を削除"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
      </button>

      <button
        hx-get="/<%= activeProject.id %>/requirements/<%= requirement.id %>/edit"
        hx-target="#requirement-card-<%= requirement.id %>"
        hx-swap="outerHTML"
        class="p-1.5 hover:bg-slate-50 border border-transparent hover:border-slate-200 text-slate-400 hover:text-slate-600 rounded-lg active:scale-95 transition-all"
        title="要件を編集"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- 説明 -->
  <p class="text-xs text-slate-600 leading-relaxed mb-4 whitespace-pre-wrap"><%= requirement.description %></p>

  <!-- 受入基準 -->
  <% if (requirement.acceptanceCriteria && requirement.acceptanceCriteria.length > 0) { %>
    <div class="border-t border-slate-100 pt-3 mt-auto">
      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">受入基準 (Acceptance Criteria)</div>
      <ul class="list-disc pl-4 space-y-1">
        <% requirement.acceptanceCriteria.forEach(criteria => { %>
          <li class="text-[11px] text-slate-600 leading-normal font-medium"><%= criteria %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>
</div>
