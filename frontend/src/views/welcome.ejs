<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ペルソナOps</title>

  <!-- Google Fonts for logo -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS Output (compiled locally) -->
  <link href="/dist/output.css" rel="stylesheet">

  <!-- Local htmx -->
  <script src="/js/htmx.min.js"></script>
  <!-- marked.js for Markdown parsing -->
  <script src="/js/marked.js"></script>
  <script src="/js/project-menu.js" defer></script>
</head>

<body class="bg-slate-50 text-slate-800 font-sans antialiased overflow-hidden">

  <div class="flex flex-col h-screen bg-slate-100 font-sans text-slate-800 overflow-hidden">
    <%- include('partials/topnav') %>
      <div class="flex-1 flex w-full relative overflow-hidden">

        <!-- ==========================================
        左サイドバー (グローバルナビ - ミニホバー展開型)
        ========================================== -->
        <%- include('partials/sidebar', { activeProject: activeProject }) %>

          <!-- ==========================================
        メインコンテンツエリア (3カラム構成)
        ========================================== -->
          <div class="flex-1 flex w-full h-full overflow-hidden">

            <!-- ==========================================
          左カラム: エージェントチャット
          ========================================== -->
            <aside id="left-panel-content"
              class="w-full bg-white z-30 flex flex-col shrink-0 transition-all duration-700 ease-in-out">
              <%- include('partials/chat-menu-active', { activeChat: null, activeProject: activeProject, isWelcome: true }) %>
            </aside>

            <!-- ==========================================
          中央カラム: シミュレーション広場（初期状態なので非表示）
          ========================================== -->
            <main id="simulation-playground"
              class="flex-1 relative bg-slate-100 flex flex-col overflow-hidden min-w-[500px]" style="display: none;">
            </main>

            <!-- ==========================================
          右カラム: 詳細パネル (非表示)
          ========================================== -->
            <aside id="detail-panel"
              class="w-[360px] bg-white border-l border-slate-200 z-30 flex flex-col shrink-0 overflow-y-auto" style="display: none;">
            </aside>

          </div>
      </div>
  </div>

  <script>
    function showSimulationPlayground() {
      const pathParts = window.location.pathname.split('/');
      const projectId = pathParts[1];
      if (!projectId) return;

      const hasDashboard = document.getElementById('simulation-dashboard');
      if (hasDashboard) {
        if (typeof htmx !== 'undefined') {
          htmx.ajax('GET', `/${projectId}/view/simulation-square`, { target: '#simulation-playground', swap: 'innerHTML' });
        }
        const leftPanel = document.getElementById('left-panel-content');
        if (leftPanel) {
          leftPanel.className = 'w-[400px] bg-white border-r border-slate-200 z-30 flex flex-col shrink-0 transition-all duration-700 ease-in-out';
        }
      }
    }

    // 最初のプロジェクト作成 & メッセージ自動送信
    async function startFirstProject(event) {
      event.preventDefault();
      const input = document.getElementById('inputText');
      if (!input) return;
      const text = input.value.trim();
      if (!text) return;

      // sessionStorage に退避
      sessionStorage.setItem('pendingStreamText', text);

      // 送信ボタンをローディング状態にする
      const submitBtn = event.target.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }

      fetch('/action/project/create', {
        method: 'POST'
      }).then(res => {
        const redirectUrl = res.headers.get('hx-redirect');
        if (redirectUrl) {
          window.location.href = redirectUrl;
        } else {
          window.location.reload();
        }
      }).catch(err => {
        console.error('Failed to create project:', err);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      });
    }
  </script>
</body>

</html>
